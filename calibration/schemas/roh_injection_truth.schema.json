{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vérité D16 des origines autozygotes",
  "type": "array",
  "minItems": 4,
  "maxItems": 4,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "replication_id",
      "scenario_id",
      "sample_id",
      "chromosome",
      "is_positive",
      "relationship_to_target",
      "source_ibd_scenario_id",
      "start_bp",
      "end_bp",
      "start_cm",
      "end_cm",
      "length_bp",
      "length_cm",
      "source_haplotype_index",
      "copied_haplotype_index"
    ],
    "properties": {
      "replication_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "scenario_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "sample_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "chromosome": {
        "type": "integer",
        "minimum": 1,
        "maximum": 22
      },
      "is_positive": {
        "type": "boolean"
      },
      "relationship_to_target": {
        "enum": [
          "NO_INJECTION",
          "TARGET_DISTINCT",
          "TARGET_OVERLAP"
        ]
      },
      "source_ibd_scenario_id": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          {
            "type": "null"
          }
        ]
      },
      "start_bp": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "end_bp": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "start_cm": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "end_cm": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "length_bp": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "length_cm": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "source_haplotype_index": {
        "anyOf": [
          {
            "const": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "copied_haplotype_index": {
        "anyOf": [
          {
            "const": 2
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "is_positive": {
              "const": false
            }
          }
        },
        "then": {
          "properties": {
            "start_bp": {
              "type": "null"
            },
            "end_bp": {
              "type": "null"
            },
            "start_cm": {
              "type": "null"
            },
            "end_cm": {
              "type": "null"
            },
            "length_bp": {
              "type": "null"
            },
            "length_cm": {
              "type": "null"
            },
            "source_haplotype_index": {
              "type": "null"
            },
            "copied_haplotype_index": {
              "type": "null"
            },
            "relationship_to_target": {
              "const": "NO_INJECTION"
            },
            "source_ibd_scenario_id": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "start_bp": {
              "not": {
                "type": "null"
              }
            },
            "end_bp": {
              "not": {
                "type": "null"
              }
            },
            "start_cm": {
              "not": {
                "type": "null"
              }
            },
            "end_cm": {
              "not": {
                "type": "null"
              }
            },
            "length_bp": {
              "not": {
                "type": "null"
              }
            },
            "length_cm": {
              "not": {
                "type": "null"
              }
            },
            "source_haplotype_index": {
              "not": {
                "type": "null"
              }
            },
            "copied_haplotype_index": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      }
    ]
  },
  "allOf": [
    {
      "contains": {
        "properties": {
          "is_positive": {
            "const": true
          }
        },
        "required": [
          "is_positive"
        ]
      },
      "minContains": 3,
      "maxContains": 3
    },
    {
      "contains": {
        "properties": {
          "is_positive": {
            "const": false
          }
        },
        "required": [
          "is_positive"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    }
  ]
}
