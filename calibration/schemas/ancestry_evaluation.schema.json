{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "evaluation_state", "report_id", "method_id", "configuration_sha256", "protocol_sha256", "calls_manifest_sha256", "reference_role", "reference_entity_count", "analysis_scope", "stage_execution_scope", "profiles", "component_count", "mixture", "stability_by_profile", "repeated_position_instability", "local_founder_check", "criteria", "technical_status", "performance_qualification", "production_promotion", "calibrated", "founder_effect_proven", "checks", "limits"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "evaluation_state": {"const": "CLOSED"},
    "report_id": {"const": "CAL-REP-16A"}, "method_id": {"const": "d27_ancestry_evaluation_v1"},
    "configuration_sha256": {"$ref": "#/$defs/hash"}, "protocol_sha256": {"$ref": "#/$defs/hash"}, "calls_manifest_sha256": {"$ref": "#/$defs/hash"},
    "reference_role": {"type": "string"}, "reference_entity_count": {"type": "integer", "minimum": 1},
    "analysis_scope": {"type": "string"}, "stage_execution_scope": {"type": "string"},
    "profiles": {"type": "array", "minItems": 8, "items": {"type": "string"}}, "component_count": {"type": "integer", "minimum": 1},
    "mixture": {"type": "object", "required": ["sample_count", "mean_absolute_error", "bootstrap_ci95_low", "bootstrap_ci95_high", "results_by_true_proportion"]},
    "stability_by_profile": {"type": "array", "minItems": 16, "items": {"type": "object", "required": ["profile_id", "scope", "entity_count", "informative_variant_count", "mean_standardized_distance", "median_standardized_distance", "p95_standardized_distance", "maximum_standardized_distance", "optimal_haplotype_swap_count"]}},
    "repeated_position_instability": {"type": "number", "minimum": 0},
    "local_founder_check": {"type": "object", "required": ["carrier_copy_count", "independent_founder_haplotype_count", "mean_founder_reference_axis_proportion", "closer_to_founder_reference_count"]},
    "criteria": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "required": ["criterion_id", "metric", "value", "threshold", "status"]}},
    "technical_status": {"const": "PASS_CORE_EVALUATOR"}, "performance_qualification": {"const": "REVIEW_REQUIRED_UNSEALED"},
    "production_promotion": {"const": false}, "calibrated": {"const": false}, "founder_effect_proven": {"const": false},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "limits": {"type": "array", "minItems": 5, "items": {"type": "string"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
