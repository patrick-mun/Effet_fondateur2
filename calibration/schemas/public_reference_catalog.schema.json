{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/calibration/schemas/public_reference_catalog.schema.json",
  "title": "Catalogue des références publiques autorisées pour la calibration",
  "description": "Liste fermée des sources publiques dont la version, l'origine, l'assemblage, les conditions d'usage et l'empreinte ont été revus avant simulation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "catalog_state",
    "reviewed_on",
    "scope",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_id": {"$ref": "#/$defs/stableIdentifier"},
    "catalog_version": {"$ref": "#/$defs/semanticVersion"},
    "catalog_state": {"const": "FROZEN"},
    "reviewed_on": {"$ref": "#/$defs/date"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "purpose",
        "default_assembly",
        "real_study_data_allowed",
        "remote_payload_sha256_required_before_use"
      ],
      "properties": {
        "project": {"const": "Effet_fondateur2_calibration"},
        "purpose": {"const": "SYNTHETIC_CALIBRATION_ONLY"},
        "default_assembly": {"const": "GRCh38"},
        "real_study_data_allowed": {"const": false},
        "remote_payload_sha256_required_before_use": {"const": true}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceRecord"},
      "allOf": [
        {"contains": {"properties": {"source_type": {"const": "PHASED_HAPLOTYPE_PANEL"}}, "required": ["source_type"]}},
        {"contains": {"properties": {"source_type": {"const": "POPULATION_METADATA"}}, "required": ["source_type"]}},
        {"contains": {"properties": {"source_type": {"const": "UNRELATED_SAMPLE_INDEX"}}, "required": ["source_type"]}},
        {"contains": {"properties": {"source_type": {"const": "GENETIC_MAP"}}, "required": ["source_type"]}},
        {
          "if": {"minItems": 5},
          "then": {
            "contains": {
              "properties": {
                "source_id": {"const": "thermofisher_cytoscan750k_accel_na36_r1"},
                "source_type": {"const": "ARRAY_DESIGN_MANIFEST"}
              },
              "required": ["source_id", "source_type"]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      ]
    }
  },
  "$defs": {
    "stableIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$"
    },
    "safeRepositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*[dD][oO][cC][kK]6_[rR][eE][aA][lL])(?!.*[dD][aA][tT][aA][\\\\/][iI][nN][pP][uU][tT])[^\\u0000]+$"
    },
    "assemblyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "name", "associated_panel_assembly", "verified", "evidence_url"],
      "properties": {
        "scope": {"enum": ["GENOMIC_COORDINATES", "ASSOCIATED_PANEL", "ASSEMBLY_INDEPENDENT"]},
        "name": {"enum": ["GRCh38", "ASSEMBLY_INDEPENDENT"]},
        "associated_panel_assembly": {"enum": ["GRCh38", "NOT_APPLICABLE"]},
        "verified": {"const": true},
        "evidence_url": {"$ref": "#/$defs/httpsUri"}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "GENOMIC_COORDINATES"}}, "required": ["scope"]},
          "then": {
            "properties": {
              "name": {"const": "GRCh38"},
              "associated_panel_assembly": {"const": "GRCh38"}
            }
          }
        },
        {
          "if": {"properties": {"scope": {"const": "ASSEMBLY_INDEPENDENT"}}, "required": ["scope"]},
          "then": {"properties": {"name": {"const": "ASSEMBLY_INDEPENDENT"}}}
        }
      ]
    },
    "originRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "canonical_url", "documentation_url"],
      "properties": {
        "provider": {"enum": ["IGSR_1000_GENOMES", "SHAPEIT4_HAPMAP", "THERMO_FISHER"]},
        "canonical_url": {"$ref": "#/$defs/httpsUri"},
        "documentation_url": {"$ref": "#/$defs/httpsUri"}
      }
    },
    "rightsRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "use_decision",
        "terms_label",
        "terms_url",
        "attribution_required",
        "redistribution_allowed_by_project",
        "reviewed_on",
        "notes"
      ],
      "properties": {
        "review_status": {
          "enum": [
            "TERMS_VERIFIED",
            "REPOSITORY_TERMS_VERIFIED_SOURCE_RIGHTS_PARTIAL"
          ]
        },
        "use_decision": {"const": "ALLOWED_LOCAL_CALIBRATION"},
        "terms_label": {"type": "string", "minLength": 1, "maxLength": 200},
        "terms_url": {"$ref": "#/$defs/httpsUri"},
        "attribution_required": {"const": true},
        "redistribution_allowed_by_project": {"const": false},
        "reviewed_on": {"$ref": "#/$defs/date"},
        "notes": {"type": "string", "minLength": 20, "maxLength": 1000}
      }
    },
    "fingerprintRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256", "scope", "verification", "asset_url"],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "scope": {"enum": ["REMOTE_ASSET", "PROVIDER_MANIFEST"]},
        "verification": {"enum": ["PROJECT_VERIFIED", "PROVIDER_MANIFEST_PROJECT_VERIFIED"]},
        "asset_url": {"$ref": "#/$defs/httpsUri"}
      }
    },
    "catalogBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_path", "sha256"],
      "properties": {
        "repository_path": {"$ref": "#/$defs/safeRepositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "acquisitionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "download_during_d09",
        "provider_checksum_algorithm",
        "provider_checksum_required",
        "local_sha256_required_before_use",
        "local_sha256_record"
      ],
      "properties": {
        "download_during_d09": {"const": false},
        "provider_checksum_algorithm": {"enum": ["MD5", "SHA-256", "NONE"]},
        "provider_checksum_required": {"type": "boolean"},
        "local_sha256_required_before_use": {"const": true},
        "local_sha256_record": {"const": "CALIBRATION_RUN_MANIFEST"}
      },
      "allOf": [
        {
          "if": {"properties": {"provider_checksum_required": {"const": false}}, "required": ["provider_checksum_required"]},
          "then": {"properties": {"provider_checksum_algorithm": {"const": "NONE"}}}
        },
        {
          "if": {"properties": {"provider_checksum_required": {"const": true}}, "required": ["provider_checksum_required"]},
          "then": {"properties": {"provider_checksum_algorithm": {"enum": ["MD5", "SHA-256"]}}}
        }
      ]
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "version",
        "allowed_roles",
        "origin",
        "assembly",
        "rights",
        "fingerprint",
        "catalog_binding",
        "acquisition"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/stableIdentifier"},
        "source_type": {
          "enum": [
            "PHASED_HAPLOTYPE_PANEL",
            "POPULATION_METADATA",
            "UNRELATED_SAMPLE_INDEX",
            "GENETIC_MAP",
            "ARRAY_DESIGN_MANIFEST"
          ]
        },
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "allowed_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DONOR_POOL_CANDIDATE",
              "PHASING_REFERENCE_CANDIDATE",
              "ANCESTRY_REFERENCE_METADATA",
              "UNRELATED_REFERENCE_METADATA",
              "RECOMBINATION_MAP",
              "OBSERVATION_MARKER_UNIVERSE"
            ]
          }
        },
        "origin": {"$ref": "#/$defs/originRecord"},
        "assembly": {"$ref": "#/$defs/assemblyRecord"},
        "rights": {"$ref": "#/$defs/rightsRecord"},
        "fingerprint": {"$ref": "#/$defs/fingerprintRecord"},
        "catalog_binding": {"$ref": "#/$defs/catalogBinding"},
        "acquisition": {"$ref": "#/$defs/acquisitionPolicy"}
      },
      "allOf": [
        {
          "if": {"properties": {"source_type": {"const": "PHASED_HAPLOTYPE_PANEL"}}, "required": ["source_type"]},
          "then": {
            "properties": {
              "allowed_roles": {
                "contains": {"const": "DONOR_POOL_CANDIDATE"},
                "minContains": 1
              },
              "origin": {
                "properties": {
                  "provider": {"const": "IGSR_1000_GENOMES"},
                  "canonical_url": {"pattern": "^https://ftp\\.1000genomes\\.ebi\\.ac\\.uk/"}
                }
              },
              "fingerprint": {"properties": {"scope": {"const": "PROVIDER_MANIFEST"}}}
            }
          }
        },
        {
          "if": {"properties": {"source_type": {"enum": ["POPULATION_METADATA", "UNRELATED_SAMPLE_INDEX"]}}, "required": ["source_type"]},
          "then": {
            "properties": {
              "origin": {
                "properties": {
                  "provider": {"const": "IGSR_1000_GENOMES"},
                  "canonical_url": {"pattern": "^https://ftp\\.1000genomes\\.ebi\\.ac\\.uk/"}
                }
              },
              "fingerprint": {"properties": {"scope": {"const": "REMOTE_ASSET"}}}
            }
          }
        },
        {
          "if": {"properties": {"source_type": {"const": "GENETIC_MAP"}}, "required": ["source_type"]},
          "then": {
            "properties": {
              "allowed_roles": {
                "contains": {"const": "RECOMBINATION_MAP"},
                "minContains": 1
              },
              "origin": {
                "properties": {
                  "provider": {"const": "SHAPEIT4_HAPMAP"},
                  "canonical_url": {"pattern": "^https://raw\\.githubusercontent\\.com/odelaneau/shapeit4/"}
                }
              },
              "rights": {
                "properties": {
                  "review_status": {"const": "REPOSITORY_TERMS_VERIFIED_SOURCE_RIGHTS_PARTIAL"}
                }
              },
              "fingerprint": {"properties": {"scope": {"const": "REMOTE_ASSET"}}}
            }
          }
        },
        {
          "if": {"properties": {"source_type": {"const": "ARRAY_DESIGN_MANIFEST"}}, "required": ["source_type"]},
          "then": {
            "properties": {
              "source_id": {"const": "thermofisher_cytoscan750k_accel_na36_r1"},
              "version": {"const": "NA36.r1"},
              "allowed_roles": {
                "contains": {"const": "OBSERVATION_MARKER_UNIVERSE"},
                "minContains": 1
              },
              "origin": {
                "properties": {
                  "provider": {"const": "THERMO_FISHER"},
                  "canonical_url": {"pattern": "^https://www\\.thermofisher\\.com/"}
                }
              },
              "assembly": {
                "properties": {
                  "scope": {"const": "GENOMIC_COORDINATES"},
                  "name": {"const": "GRCh38"},
                  "associated_panel_assembly": {"const": "GRCh38"}
                }
              },
              "fingerprint": {"properties": {"scope": {"const": "REMOTE_ASSET"}}}
            }
          }
        }
      ]
    }
  }
}
