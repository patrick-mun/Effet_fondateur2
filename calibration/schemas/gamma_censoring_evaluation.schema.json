{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma_censoring_evaluation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "method_id", "evaluation_state",
    "configuration_sha256", "protocol_sha256", "bench_manifest_sha256",
    "run_manifest_sha256", "technical_status", "performance_qualification",
    "independent_contract_qualification", "correlated_stress_qualification",
    "production_promotion", "design", "analytic_fixture", "primary_result",
    "method_results", "results_by_age", "results_by_family_count",
    "criteria", "limits", "calibrated", "founder_effect_proven"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"const": "CAL-REP-14B"},
    "method_id": {"const": "d25b_gamma_type2_censoring_evaluation_v1"},
    "evaluation_state": {"const": "CLOSED"},
    "configuration_sha256": {"$ref": "#/$defs/hash"},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "bench_manifest_sha256": {"$ref": "#/$defs/hash"},
    "run_manifest_sha256": {"$ref": "#/$defs/hash"},
    "technical_status": {"enum": ["PASS", "FAIL"]},
    "performance_qualification": {"enum": ["PASS_INDEPENDENT_ONLY", "FAIL"]},
    "independent_contract_qualification": {"enum": ["PASS", "FAIL"]},
    "correlated_stress_qualification": {"const": "REVIEW_REQUIRED"},
    "production_promotion": {"const": false},
    "design": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ages_generations", "family_counts", "genealogy_profiles",
        "replications_per_cell", "scenario_count", "estimate_row_count",
        "confidence_level", "observation_contract"
      ],
      "properties": {
        "ages_generations": {"type": "array", "minItems": 10, "items": {"type": "integer"}},
        "family_counts": {"type": "array", "minItems": 3, "items": {"type": "integer"}},
        "genealogy_profiles": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/genealogy"}},
        "replications_per_cell": {"type": "integer", "minimum": 200},
        "scenario_count": {"type": "integer", "minimum": 1},
        "estimate_row_count": {"type": "integer", "minimum": 1},
        "confidence_level": {"const": 0.95},
        "observation_contract": {"const": "PAIRWISE_SHARED_TYPE2_CENSORED"}
      }
    },
    "analytic_fixture": {
      "type": "object", "additionalProperties": false,
      "required": [
        "event_count", "total_exposure_morgans", "expected_generations",
        "observed_generations", "absolute_error_generations"
      ],
      "properties": {
        "event_count": {"type": "integer", "minimum": 2},
        "total_exposure_morgans": {"type": "number", "exclusiveMinimum": 0},
        "expected_generations": {"type": "number", "exclusiveMinimum": 0},
        "observed_generations": {"type": "number", "exclusiveMinimum": 0},
        "absolute_error_generations": {"type": "number", "minimum": 0}
      }
    },
    "primary_result": {"$ref": "#/$defs/result_with_lofo"},
    "method_results": {"type": "array", "minItems": 12, "items": {"$ref": "#/$defs/result"}},
    "results_by_age": {"type": "array", "minItems": 30, "items": {"$ref": "#/$defs/age_result"}},
    "results_by_family_count": {"type": "array", "minItems": 9, "items": {"$ref": "#/$defs/family_result"}},
    "criteria": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/criterion"}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["phase_error", "marker_resolution", "chance_sharing", "d24_false_positives"],
      "properties": {
        "phase_error": {"const": "NOT_EVALUABLE"},
        "marker_resolution": {"const": "NOT_EVALUABLE"},
        "chance_sharing": {"const": "NOT_MODELLED"},
        "d24_false_positives": {"const": "NOT_ADDRESSED"}
      }
    },
    "calibrated": {"const": false},
    "founder_effect_proven": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_number": {"type": ["number", "null"]},
    "genealogy": {"enum": ["INDEPENDENT", "CORRELATED_25", "CORRELATED_50"]},
    "method": {"enum": ["TYPE2_CENSORED_INDEPENDENT_V3", "R_FAITHFUL_INDEPENDENT_V2", "R_FAITHFUL_CORRELATED_V2", "FULL_INDEPENDENT_ORACLE_V1"]},
    "metrics": {
      "type": "object",
      "required": [
        "total_count", "estimated_count", "not_evaluable_count", "bias",
        "bias_ci95_low", "bias_ci95_high", "mae", "mae_ci95_low",
        "mae_ci95_high", "rmse", "rmse_ci95_low", "rmse_ci95_high",
        "coverage_numerator", "coverage_denominator", "coverage",
        "coverage_ci95_low", "coverage_ci95_high",
        "mean_interval_length_generations"
      ],
      "properties": {
        "total_count": {"type": "integer", "minimum": 0},
        "estimated_count": {"type": "integer", "minimum": 0},
        "not_evaluable_count": {"type": "integer", "minimum": 0},
        "bias": {"$ref": "#/$defs/nullable_number"},
        "bias_ci95_low": {"$ref": "#/$defs/nullable_number"},
        "bias_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "mae": {"$ref": "#/$defs/nullable_number"},
        "mae_ci95_low": {"$ref": "#/$defs/nullable_number"},
        "mae_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "rmse": {"$ref": "#/$defs/nullable_number"},
        "rmse_ci95_low": {"$ref": "#/$defs/nullable_number"},
        "rmse_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "coverage_numerator": {"type": "integer", "minimum": 0},
        "coverage_denominator": {"type": "integer", "minimum": 0},
        "coverage": {"$ref": "#/$defs/nullable_number"},
        "coverage_ci95_low": {"$ref": "#/$defs/nullable_number"},
        "coverage_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "mean_interval_length_generations": {"$ref": "#/$defs/nullable_number"}
      }
    },
    "result_core": {
      "allOf": [
        {"$ref": "#/$defs/metrics"},
        {"type": "object", "required": ["genealogy_profile", "method"], "properties": {"genealogy_profile": {"$ref": "#/$defs/genealogy"}, "method": {"$ref": "#/$defs/method"}}}
      ]
    },
    "result": {
      "allOf": [
        {"$ref": "#/$defs/result_core"}
      ],
      "unevaluatedProperties": false
    },
    "result_with_lofo": {
      "allOf": [
        {"$ref": "#/$defs/result_core"},
        {"type": "object", "required": ["lofo_evaluable_count", "lofo_mean_max_absolute_delta_generations", "lofo_p95_max_absolute_delta_generations"], "properties": {"lofo_evaluable_count": {"type": "integer", "minimum": 0}, "lofo_mean_max_absolute_delta_generations": {"$ref": "#/$defs/nullable_number"}, "lofo_p95_max_absolute_delta_generations": {"$ref": "#/$defs/nullable_number"}}}
      ],
      "unevaluatedProperties": false
    },
    "age_result": {
      "allOf": [
        {"$ref": "#/$defs/result_core"},
        {"type": "object", "required": ["age_generations"], "properties": {"age_generations": {"type": "integer", "minimum": 1}}}
      ],
      "unevaluatedProperties": false
    },
    "family_result": {
      "allOf": [
        {"$ref": "#/$defs/result_core"},
        {"type": "object", "required": ["family_count"], "properties": {"family_count": {"type": "integer", "minimum": 3}}}
      ],
      "unevaluatedProperties": false
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "metric", "value", "lower_threshold", "upper_threshold", "status"],
      "properties": {
        "criterion_id": {"type": "string", "pattern": "^CAL-AGE-B0[1-7]$"},
        "metric": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/nullable_number"},
        "lower_threshold": {"$ref": "#/$defs/nullable_number"},
        "upper_threshold": {"$ref": "#/$defs/nullable_number"},
        "status": {"enum": ["PASS", "FAIL", "REVIEW_REQUIRED"]}
      }
    }
  }
}
