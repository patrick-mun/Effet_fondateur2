{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method_id",
    "preparation_manifest_sha256",
    "density_profiles",
    "regional_pedigree_modes",
    "rare_maf_upper_bound",
    "map_absolute_tolerance_cm",
    "phasing_seed",
    "bootstrap_seed",
    "bootstrap_replicates",
    "density_gap_bp",
    "target_flank_bp",
    "command_timeout_seconds",
    "minimum_total_variants",
    "minimum_variants_per_autosome"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "method_id": {"const": "paired_density_pedigree_phasing_bench_v1"},
    "preparation_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "density_profiles": {
      "const": [
        {"profile_id": "DENSITY_25", "rank_residues": [0], "rank_modulus": 4},
        {"profile_id": "DENSITY_50", "rank_residues": [0, 2], "rank_modulus": 4},
        {"profile_id": "DENSITY_75", "rank_residues": [0, 1, 2], "rank_modulus": 4},
        {"profile_id": "DENSITY_100", "rank_residues": [0, 1, 2, 3], "rank_modulus": 4}
      ]
    },
    "regional_pedigree_modes": {"const": ["WITH_PEDIGREE", "WITHOUT_PEDIGREE"]},
    "rare_maf_upper_bound": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.5},
    "map_absolute_tolerance_cm": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.001},
    "phasing_seed": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "bootstrap_seed": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "bootstrap_replicates": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "density_gap_bp": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "target_flank_bp": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "command_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "minimum_total_variants": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "minimum_variants_per_autosome": {"type": "integer", "minimum": 1, "maximum": 4294967295}
  }
}
