{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:effet-fondateur:calibration:blinded-input-inventory:1.0.0",
  "title": "Closed whitelist of blinded inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "release_id", "partition_id", "opaque_view_id", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "inventory_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "partition_id": {"enum": ["CALIBRATION", "VALIDATION_BLIND", "RESOURCE_ONLY"]},
    "opaque_view_id": {"type": "string", "pattern": "^VIEW-[0-9a-f]{16,64}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "relative_path", "sha256", "size_bytes", "media_type"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*private_truth)(?!.*governance).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
