{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "method_id", "closure_state", "preparation_manifest_sha256", "configuration_sha256", "scope", "fixture_producer", "implementation_sha256", "autosomal", "regional", "artifacts", "calibrated", "founder_effect_proven"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "method_id": {"const": "paired_density_pedigree_phasing_bench_v1"},
    "closure_state": {"const": "CLOSED"},
    "preparation_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"const": "ISOLATED_COMPONENTS_10A_11_12_12A_NOT_04_09"},
    "fixture_producer": {"const": "D23_UPSTREAM_CONTRACT_FIXTURE"},
    "implementation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "autosomal": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/cell"}
    },
    "regional": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {"$ref": "#/$defs/cell"}
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "calibrated": {"const": false},
    "founder_effect_proven": {"const": false}
  },
  "$defs": {
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "observed_markers", "pedigree_mode", "stages"],
      "properties": {
        "profile": {"enum": ["DENSITY_25", "DENSITY_50", "DENSITY_75", "DENSITY_100"]},
        "observed_markers": {"type": "integer", "minimum": 1},
        "pedigree_mode": {"enum": ["WITH_PEDIGREE", "WITHOUT_PEDIGREE", "WITHOUT_PEDIGREE_BY_CONTRACT"]},
        "stages": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "object"}}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
