{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma_audit_config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "configuration_id", "config_state", "legacy_method_id", "candidate_method_id", "oracle_method_id", "official_r_script_url", "official_r_script_sha256", "ages_generations", "family_counts", "replications_per_cell", "genealogy_profiles", "observation_profiles", "simulation_seed", "bootstrap_seed", "bootstrap_draws", "confidence_level", "criteria", "r_reference_fixtures", "calibrated", "founder_effect_proven"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "configuration_id": {"const": "d25a_gamma_audit_v1"},
    "config_state": {"const": "FINALIZED"},
    "legacy_method_id": {"const": "gamma_gandolfo_2014_v1"},
    "candidate_method_id": {"const": "gamma_gandolfo_2014_r_faithful_v2"},
    "oracle_method_id": {"const": "gamma_complete_breakpoint_independent_oracle_v1"},
    "official_r_script_url": {"type": "string", "format": "uri"},
    "official_r_script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ages_generations": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "family_counts": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "integer", "minimum": 3}},
    "replications_per_cell": {"type": "integer", "minimum": 100},
    "genealogy_profiles": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["profile", "shared_path_fraction"], "properties": {"profile": {"type": "string", "enum": ["INDEPENDENT", "CORRELATED_25", "CORRELATED_50"]}, "shared_path_fraction": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}}}},
    "observation_profiles": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "enum": ["FULL_BREAKPOINTS", "PAIRWISE_SHARED_TRUNCATED"]}},
    "simulation_seed": {"type": "integer", "minimum": 1},
    "bootstrap_seed": {"type": "integer", "minimum": 1},
    "bootstrap_draws": {"type": "integer", "minimum": 500},
    "confidence_level": {"const": 0.95},
    "criteria": {"type": "object", "additionalProperties": false, "required": ["maximum_r_parity_error_generations", "maximum_absolute_oracle_bias_generations", "minimum_oracle_coverage", "maximum_oracle_coverage", "maximum_absolute_truncated_independent_bias_generations", "minimum_truncated_independent_coverage", "maximum_truncated_independent_coverage"], "properties": {"maximum_r_parity_error_generations": {"type": "number", "minimum": 0}, "maximum_absolute_oracle_bias_generations": {"type": "number", "minimum": 0}, "minimum_oracle_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "maximum_oracle_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "maximum_absolute_truncated_independent_bias_generations": {"type": "number", "minimum": 0}, "minimum_truncated_independent_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "maximum_truncated_independent_coverage": {"type": "number", "minimum": 0, "maximum": 1}}},
    "r_reference_fixtures": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "expected_rho_region", "left_lengths_cm", "right_lengths_cm", "chance_sharing"], "properties": {"fixture_id": {"type": "string", "minLength": 1}, "expected_rho_region": {"type": "string", "enum": ["I1", "I2", "I3", "NONNEGATIVE"]}, "left_lengths_cm": {"type": "array", "minItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}}, "right_lengths_cm": {"type": "array", "minItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}}, "chance_sharing": {"type": "object", "additionalProperties": false, "required": ["enabled", "median_allele_frequency", "markers_on_chromosome", "chromosome_length_cm"], "properties": {"enabled": {"type": "boolean"}, "median_allele_frequency": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "markers_on_chromosome": {"type": "integer", "minimum": 1}, "chromosome_length_cm": {"type": "number", "exclusiveMinimum": 0}}}}}},
    "calibrated": {"const": false},
    "founder_effect_proven": {"const": false}
  }
}
