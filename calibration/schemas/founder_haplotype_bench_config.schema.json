{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/calibration/schemas/founder_haplotype_bench_config.schema.json",
  "title": "Configuration du banc D24 d’haplotype fondateur",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "method_id", "protocol_version", "primary_profile",
    "sensitivity_profiles", "minimum_independent_units_per_scenario",
    "minimum_positive_scenarios", "minimum_negative_scenarios",
    "minimum_flank_markers", "confidence_level", "true_consensus_policy",
    "detection_status", "target_containment_policy", "boundary_units",
    "qualification_lifecycle", "profile_construction", "profile_seed",
    "missing_seed", "target_missing_policy", "scenarios"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "method_id": {"const": "founder_haplotype_truth_bench_v1"},
    "protocol_version": {"const": "1.0.0"},
    "primary_profile": {"const": "MAXIMUM"},
    "sensitivity_profiles": {
      "const": ["BASELINE", "DENSITY_50", "MISSING_1PCT"]
    },
    "minimum_independent_units_per_scenario": {"const": 3},
    "minimum_positive_scenarios": {"const": 5},
    "minimum_negative_scenarios": {"const": 5},
    "minimum_flank_markers": {"const": 2},
    "confidence_level": {"const": 0.95},
    "true_consensus_policy": {"const": "INTERSECTION_OF_FAMILY_SEGMENTS"},
    "detection_status": {"const": "SUPPORTED_IBS_CANDIDATE"},
    "target_containment_policy": {"const": "CLOSED_INTERVAL"},
    "boundary_units": {"const": ["bp", "cM"]},
    "qualification_lifecycle": {"const": "pilot_then_seal"},
    "profile_construction": {
      "type": "object", "additionalProperties": false,
      "required": ["MAXIMUM", "BASELINE", "DENSITY_50", "MISSING_1PCT"],
      "properties": {
        "MAXIMUM": {"$ref": "#/$defs/maximumProfile"},
        "BASELINE": {"$ref": "#/$defs/baselineProfile"},
        "DENSITY_50": {"$ref": "#/$defs/densityProfile"},
        "MISSING_1PCT": {"$ref": "#/$defs/missingProfile"}
      }
    },
    "profile_seed": {"const": 2420},
    "missing_seed": {"const": 2421},
    "target_missing_policy": {"const": "PROTECTED"},
    "scenarios": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "maximumProfile": {
      "const": {"marker_source": "D23B_MAXIMUM_CHIP_UNIVERSE", "marker_fraction": 1.0, "missing_rate": 0.0}
    },
    "baselineProfile": {
      "const": {"marker_source": "D23A_BASELINE_CHIP_UNIVERSE", "marker_fraction": null, "missing_rate": 0.0}
    },
    "densityProfile": {
      "const": {"marker_source": "D23B_MAXIMUM_CHIP_UNIVERSE", "marker_fraction": 0.5, "missing_rate": 0.0}
    },
    "missingProfile": {
      "const": {"marker_source": "D23B_MAXIMUM_CHIP_UNIVERSE", "marker_fraction": 1.0, "missing_rate": 0.01}
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": [
        "scenario_id", "truth_role", "age_generations", "random_seed",
        "construction"
      ],
      "properties": {
        "scenario_id": {
          "type": "string", "pattern": "^D24_(?:POS|NEG)_[A-Z0-9_]+$"
        },
        "truth_role": {"enum": ["POSITIVE", "NEGATIVE"]},
        "age_generations": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "random_seed": {"type": "integer", "minimum": 1},
        "construction": {
          "enum": [
            "FOUNDER_RECOMBINATION",
            "INDEPENDENT_TARGET_CARRIERS_NO_SHARED_SEGMENT"
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"truth_role": {"const": "POSITIVE"}}},
          "then": {
            "properties": {
              "age_generations": {"type": "integer"},
              "construction": {"const": "FOUNDER_RECOMBINATION"}
            }
          },
          "else": {
            "properties": {
              "age_generations": {"type": "null"},
              "construction": {
                "const": "INDEPENDENT_TARGET_CARRIERS_NO_SHARED_SEGMENT"
              }
            }
          }
        }
      ]
    }
  }
}
