{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "method_id",
        "stage_id",
        "evaluations",
        "status",
        "performance_qualification",
        "calibrated",
        "founder_effect_proven"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "method_id": {
          "const": "paired_chip_phasing_bench_v1"
        },
        "stage_id": {
          "const": "10A"
        },
        "evaluations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/autosomal_input"
              },
              {
                "$ref": "#/$defs/failure"
              },
              {
                "$ref": "#/$defs/missing"
              }
            ]
          }
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE"
          ]
        },
        "performance_qualification": {
          "const": "NOT_APPLICABLE"
        },
        "calibrated": {
          "const": false
        },
        "founder_effect_proven": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "method_id",
        "stage_id",
        "evaluations",
        "status",
        "performance_qualification",
        "calibrated",
        "founder_effect_proven"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "method_id": {
          "const": "paired_chip_phasing_bench_v1"
        },
        "stage_id": {
          "const": "11"
        },
        "evaluations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/region"
              },
              {
                "$ref": "#/$defs/failure"
              },
              {
                "$ref": "#/$defs/missing"
              }
            ]
          }
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE"
          ]
        },
        "performance_qualification": {
          "const": "NOT_APPLICABLE"
        },
        "calibrated": {
          "const": false
        },
        "founder_effect_proven": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "method_id",
        "stage_id",
        "evaluations",
        "status",
        "performance_qualification",
        "calibrated",
        "founder_effect_proven"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "method_id": {
          "const": "paired_chip_phasing_bench_v1"
        },
        "stage_id": {
          "const": "12"
        },
        "evaluations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/phase"
              },
              {
                "$ref": "#/$defs/failure"
              },
              {
                "$ref": "#/$defs/missing"
              }
            ]
          }
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE"
          ]
        },
        "performance_qualification": {
          "const": "REVIEW_REQUIRED"
        },
        "calibrated": {
          "const": false
        },
        "founder_effect_proven": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "method_id",
        "stage_id",
        "evaluations",
        "status",
        "performance_qualification",
        "calibrated",
        "founder_effect_proven"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "method_id": {
          "const": "paired_chip_phasing_bench_v1"
        },
        "stage_id": {
          "const": "12A"
        },
        "evaluations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/phase"
              },
              {
                "$ref": "#/$defs/failure"
              },
              {
                "$ref": "#/$defs/missing"
              }
            ]
          }
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE"
          ]
        },
        "performance_qualification": {
          "const": "REVIEW_REQUIRED"
        },
        "calibrated": {
          "const": false
        },
        "founder_effect_proven": {
          "const": false
        }
      }
    }
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator",
        "estimate",
        "status",
        "contributing_units",
        "interval_95",
        "bootstrap_valid_replicates",
        "interval_method"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "estimate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "EVALUABLE",
            "NOT_EVALUABLE"
          ]
        },
        "contributing_units": {
          "type": "integer",
          "minimum": 0
        },
        "interval_95": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "bootstrap_valid_replicates": {
          "type": "integer",
          "minimum": 0
        },
        "interval_method": {
          "const": "FAMILY_CLUSTER_PERCENTILE_DESCRIPTIVE"
        },
        "interval_reason": {
          "enum": [
            "ZERO_DENOMINATOR",
            "FEWER_THAN_TWO_CONTRIBUTING_UNITS"
          ]
        }
      }
    },
    "strata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ALL",
        "MAF_LE_005",
        "MAF_GT_005",
        "GAP_LE_100KB",
        "GAP_GT_100KB"
      ],
      "properties": {
        "ALL": {
          "$ref": "#/$defs/metric"
        },
        "MAF_LE_005": {
          "$ref": "#/$defs/metric"
        },
        "MAF_GT_005": {
          "$ref": "#/$defs/metric"
        },
        "GAP_LE_100KB": {
          "$ref": "#/$defs/metric"
        },
        "GAP_GT_100KB": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "switch_error_rate",
        "haplotype_hamming_rate",
        "isolated_point_motif_rate",
        "rare_variant_phase_error_rate",
        "target_mutation_orientation_accuracy"
      ],
      "properties": {
        "switch_error_rate": {
          "$ref": "#/$defs/strata"
        },
        "haplotype_hamming_rate": {
          "$ref": "#/$defs/strata"
        },
        "isolated_point_motif_rate": {
          "$ref": "#/$defs/strata"
        },
        "rare_variant_phase_error_rate": {
          "$ref": "#/$defs/strata"
        },
        "target_mutation_orientation_accuracy": {
          "$ref": "#/$defs/strata"
        }
      }
    },
    "concordance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "stage_id",
        "status",
        "reasons",
        "metrics"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "pattern": "^CAL-REP-(10A|11)$"
        },
        "stage_id": {
          "enum": [
            "10A",
            "11"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sample_lost_count",
            "sample_extra_count",
            "sample_duplicate_count",
            "sample_order_mismatch_count",
            "variant_lost_count",
            "variant_extra_count",
            "variant_duplicate_count",
            "variant_order_mismatch_count",
            "genotype_mismatch_count",
            "genotype_compared_count",
            "missing_call_mismatch_count",
            "genotype_discordance_rate"
          ],
          "properties": {
            "sample_lost_count": {
              "type": "integer",
              "minimum": 0
            },
            "sample_extra_count": {
              "type": "integer",
              "minimum": 0
            },
            "sample_duplicate_count": {
              "type": "integer",
              "minimum": 0
            },
            "sample_order_mismatch_count": {
              "type": "integer",
              "minimum": 0
            },
            "variant_lost_count": {
              "type": "integer",
              "minimum": 0
            },
            "variant_extra_count": {
              "type": "integer",
              "minimum": 0
            },
            "variant_duplicate_count": {
              "type": "integer",
              "minimum": 0
            },
            "variant_order_mismatch_count": {
              "type": "integer",
              "minimum": 0
            },
            "genotype_mismatch_count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "genotype_compared_count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "missing_call_mismatch_count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "genotype_discordance_rate": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "autosomal_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "concordance",
        "source_markers",
        "expected_markers",
        "observed_markers",
        "excluded_incomplete",
        "excluded_monomorphic",
        "chromosome_counts",
        "criteria"
      ],
      "properties": {
        "profile": {
          "enum": [
            "BASELINE",
            "DENSITY_50",
            "MISSING_1PCT"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE"
          ]
        },
        "concordance": {
          "$ref": "#/$defs/concordance"
        },
        "source_markers": {
          "type": "integer",
          "minimum": 0
        },
        "expected_markers": {
          "type": "integer",
          "minimum": 0
        },
        "observed_markers": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_incomplete": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_monomorphic": {
          "type": "integer",
          "minimum": 0
        },
        "chromosome_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chromosome",
              "expected",
              "observed"
            ],
            "properties": {
              "chromosome": {
                "type": "integer",
                "minimum": 1,
                "maximum": 22
              },
              "expected": {
                "type": "integer",
                "minimum": 0
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "minItems": 22,
          "maxItems": 22
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "concordance",
        "expected_markers",
        "observed_markers",
        "map_coordinate_error_count",
        "map_order_correct",
        "map_max_absolute_error_cm",
        "target_retained",
        "map_plot",
        "criteria"
      ],
      "properties": {
        "profile": {
          "enum": [
            "BASELINE",
            "DENSITY_50",
            "MISSING_1PCT"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE"
          ]
        },
        "concordance": {
          "$ref": "#/$defs/concordance"
        },
        "expected_markers": {
          "type": "integer",
          "minimum": 0
        },
        "observed_markers": {
          "type": "integer",
          "minimum": 0
        },
        "map_coordinate_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "map_order_correct": {
          "type": "boolean"
        },
        "map_max_absolute_error_cm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "target_retained": {
          "type": "boolean"
        },
        "map_plot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position_bp",
            "expected_cm",
            "observed_cm"
          ],
          "properties": {
            "position_bp": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "expected_cm": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "observed_cm": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "alignment",
        "samples",
        "observed_loci",
        "independent_units",
        "complete_genotypes",
        "missing_genotypes",
        "genotype_discordances",
        "truth_heterozygotes",
        "phased_heterozygotes",
        "unphased_heterozygotes",
        "target_heterozygotes",
        "metrics",
        "error_run_lengths",
        "qualification_status",
        "calibrated",
        "founder_effect_proven",
        "sample_order_correct",
        "variant_order_correct",
        "reference_membership_correct",
        "target_retained",
        "observed_genotype_preservation_errors",
        "map_coordinate_error_count",
        "published_manual_review_required",
        "reliable_carrier_count",
        "unreliable_carrier_count",
        "chromosome_counts",
        "criteria"
      ],
      "properties": {
        "profile": {
          "enum": [
            "BASELINE",
            "DENSITY_50",
            "MISSING_1PCT"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE"
          ]
        },
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "absent_loci",
            "swapped_loci",
            "sample_order_changed"
          ],
          "properties": {
            "absent_loci": {
              "type": "integer",
              "minimum": 0
            },
            "swapped_loci": {
              "type": "integer",
              "minimum": 0
            },
            "sample_order_changed": {
              "enum": [
                0,
                1
              ]
            }
          }
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "observed_loci": {
          "type": "integer",
          "minimum": 0
        },
        "independent_units": {
          "type": "integer",
          "minimum": 0
        },
        "complete_genotypes": {
          "type": "integer",
          "minimum": 0
        },
        "missing_genotypes": {
          "type": "integer",
          "minimum": 0
        },
        "genotype_discordances": {
          "type": "integer",
          "minimum": 0
        },
        "truth_heterozygotes": {
          "type": "integer",
          "minimum": 0
        },
        "phased_heterozygotes": {
          "type": "integer",
          "minimum": 0
        },
        "unphased_heterozygotes": {
          "type": "integer",
          "minimum": 0
        },
        "target_heterozygotes": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "error_run_lengths": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length_1",
            "length_2_to_5",
            "length_6_plus"
          ],
          "properties": {
            "length_1": {
              "type": "integer",
              "minimum": 0
            },
            "length_2_to_5": {
              "type": "integer",
              "minimum": 0
            },
            "length_6_plus": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "qualification_status": {
          "const": "REVIEW_REQUIRED"
        },
        "calibrated": {
          "const": false
        },
        "founder_effect_proven": {
          "const": false
        },
        "sample_order_correct": {
          "type": "boolean"
        },
        "variant_order_correct": {
          "type": "boolean"
        },
        "reference_membership_correct": {
          "type": "boolean"
        },
        "target_retained": {
          "type": "boolean"
        },
        "observed_genotype_preservation_errors": {
          "type": "integer",
          "minimum": 0
        },
        "map_coordinate_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "published_manual_review_required": {
          "type": "boolean"
        },
        "reliable_carrier_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unreliable_carrier_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "chromosome_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chromosome",
              "observed"
            ],
            "properties": {
              "chromosome": {
                "type": "integer",
                "minimum": 1,
                "maximum": 22
              },
              "observed": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "returncode",
        "metrics_status",
        "criteria"
      ],
      "properties": {
        "profile": {
          "enum": [
            "BASELINE",
            "DENSITY_50",
            "MISSING_1PCT"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE"
          ]
        },
        "returncode": {
          "type": "integer",
          "minimum": 1
        },
        "metrics_status": {
          "const": "NOT_EVALUABLE"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "reason",
        "criteria"
      ],
      "properties": {
        "profile": {
          "enum": [
            "BASELINE",
            "DENSITY_50",
            "MISSING_1PCT"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE"
          ]
        },
        "reason": {
          "const": "UPSTREAM_COMPONENT_FAILED"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "metric",
        "value",
        "denominator",
        "threshold",
        "lifecycle",
        "status"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^CAL-PHASE-00[1-6]$"
        },
        "metric": {
          "enum": [
            "autosomal_sample_or_variant_universe_mismatch_count",
            "genetic_map_or_coordinate_consistency_error_count",
            "target_variant_retained",
            "switch_error_rate",
            "rare_variant_phase_error_rate",
            "target_mutation_orientation_accuracy"
          ]
        },
        "value": {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        "denominator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "threshold": {
          "type": [
            "number",
            "boolean",
            "null"
          ]
        },
        "lifecycle": {
          "enum": [
            "fixed_contract",
            "pilot_then_seal"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE",
            "REVIEW_REQUIRED"
          ]
        }
      }
    }
  }
}
