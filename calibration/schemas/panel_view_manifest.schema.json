{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:effet-fondateur:calibration:panel-view-manifest:1.0.0",
  "title": "Blinded panel view manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "partition_id", "views"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "minLength": 1},
    "partition_id": {"enum": ["CALIBRATION", "VALIDATION_BLIND", "RESOURCE_ONLY"]},
    "views": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["view_type", "opaque_view_id", "parent_sha256", "transformation_id", "consumer_stages", "inventory_path"],
        "properties": {
          "view_type": {"enum": ["V-SOURCE", "V-TARGET", "V-DENSITY", "V-MEASUREMENT", "V-PEDIGREE", "V-REGIONAL", "V-AUTOSOMAL", "V-PHASING-REFERENCE", "V-FOUNDER-NULL", "V-ROH-IBD", "V-SENSITIVITY"]},
          "opaque_view_id": {"type": "string", "pattern": "^VIEW-[0-9a-f]{16,64}$"},
          "parent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "transformation_id": {"type": "string", "minLength": 1},
          "consumer_stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "inventory_path": {"type": "string", "pattern": "^blinded_inputs/"}
        }
      }
    }
  }
}
