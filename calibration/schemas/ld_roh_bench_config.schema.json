{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ld_roh_bench_config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "configuration_id", "configuration_state", "authorization_id", "panel_role", "source_d16_manifest_sha256", "source_d17_manifest_sha256", "profiles", "nonphased_aliases", "target", "ld", "roh", "performance_thresholds_sealed", "production_promotion", "calibrated", "founder_effect_proven"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "configuration_id": {"const": "d26_ld_roh_bench_v1"},
    "configuration_state": {"const": "FINALIZED"},
    "authorization_id": {"const": "CAL-DEC-014"},
    "panel_role": {"const": "CALIBRATION"},
    "source_d16_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_d17_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "profiles": {"type": "array", "prefixItems": [{"const": "control"}, {"const": "missing_01"}, {"const": "missing_05"}, {"const": "genotype_01"}, {"const": "density_50"}, {"const": "combined"}], "items": false},
    "nonphased_aliases": {"type": "object", "additionalProperties": false, "required": ["phase_point_02", "phase_switch_02"], "properties": {"phase_point_02": {"const": "control"}, "phase_switch_02": {"const": "control"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["chromosome", "position_bp", "variant_id"], "properties": {"chromosome": {"const": "5"}, "position_bp": {"const": 84991179}, "variant_id": {"const": "S-3IFSF"}}},
    "ld": {"$ref": "#/$defs/ld"},
    "roh": {"$ref": "#/$defs/roh"},
    "performance_thresholds_sealed": {"const": false},
    "production_promotion": {"const": false},
    "calibrated": {"const": false},
    "founder_effect_proven": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0},
    "ld": {"type": "object", "additionalProperties": false, "required": ["minimum_samples", "minimum_primary_samples", "minimum_called_samples_per_pair", "minimum_variant_maf", "minimum_pairs_per_bin", "max_pair_distance_bp", "max_pair_distance_cm", "distance_bins_cm", "max_pair_count", "plink_timeout_seconds"], "properties": {"minimum_samples": {"$ref": "#/$defs/positiveInteger"}, "minimum_primary_samples": {"$ref": "#/$defs/positiveInteger"}, "minimum_called_samples_per_pair": {"$ref": "#/$defs/positiveInteger"}, "minimum_variant_maf": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5}, "minimum_pairs_per_bin": {"$ref": "#/$defs/positiveInteger"}, "max_pair_distance_bp": {"$ref": "#/$defs/positiveInteger"}, "max_pair_distance_cm": {"$ref": "#/$defs/positiveNumber"}, "distance_bins_cm": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/positiveNumber"}}, "max_pair_count": {"$ref": "#/$defs/positiveInteger"}, "plink_timeout_seconds": {"$ref": "#/$defs/positiveInteger"}}},
    "roh": {"type": "object", "additionalProperties": false, "required": ["minimum_roh_kb", "minimum_roh_snps", "maximum_density_kb_per_snp", "maximum_gap_kb", "window_snps", "window_max_heterozygotes", "window_max_missing", "window_threshold", "minimum_genomewide_variants", "minimum_genomewide_autosomes", "minimum_target_chromosome_variants", "minimum_group_samples", "minimum_primary_samples", "autosomal_denominator_kb", "autosomal_denominator_source", "plink_timeout_seconds", "minimum_reference_overlap_fraction"], "properties": {"minimum_roh_kb": {"$ref": "#/$defs/positiveNumber"}, "minimum_roh_snps": {"$ref": "#/$defs/positiveInteger"}, "maximum_density_kb_per_snp": {"$ref": "#/$defs/positiveNumber"}, "maximum_gap_kb": {"$ref": "#/$defs/positiveNumber"}, "window_snps": {"$ref": "#/$defs/positiveInteger"}, "window_max_heterozygotes": {"type": "integer", "minimum": 0}, "window_max_missing": {"type": "integer", "minimum": 0}, "window_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "minimum_genomewide_variants": {"$ref": "#/$defs/positiveInteger"}, "minimum_genomewide_autosomes": {"$ref": "#/$defs/positiveInteger"}, "minimum_target_chromosome_variants": {"$ref": "#/$defs/positiveInteger"}, "minimum_group_samples": {"$ref": "#/$defs/positiveInteger"}, "minimum_primary_samples": {"$ref": "#/$defs/positiveInteger"}, "autosomal_denominator_kb": {"type": "null"}, "autosomal_denominator_source": {"type": "null"}, "plink_timeout_seconds": {"$ref": "#/$defs/positiveInteger"}, "minimum_reference_overlap_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}}
  }
}
