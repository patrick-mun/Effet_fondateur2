{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variant_age_evaluation.schema.json",
  "$defs": {
    "nullable_number": {"type": ["number", "null"]},
    "metric_summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total_count", "estimated_count", "not_evaluable_count", "bias", "bias_ci95_low", "bias_ci95_high", "mae", "mae_ci95_low", "mae_ci95_high", "rmse", "rmse_ci95_low", "rmse_ci95_high", "coverage_numerator", "coverage_denominator", "coverage", "coverage_ci95_low", "coverage_ci95_high"],
      "properties": {
        "total_count": {"type": "integer", "minimum": 0},
        "estimated_count": {"type": "integer", "minimum": 0},
        "not_evaluable_count": {"type": "integer", "minimum": 0},
        "bias": {"$ref": "#/$defs/nullable_number"},
        "bias_ci95_low": {"$ref": "#/$defs/nullable_number"},
        "bias_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "mae": {"$ref": "#/$defs/nullable_number"},
        "mae_ci95_low": {"$ref": "#/$defs/nullable_number"},
        "mae_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "rmse": {"$ref": "#/$defs/nullable_number"},
        "rmse_ci95_low": {"$ref": "#/$defs/nullable_number"},
        "rmse_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "coverage_numerator": {"type": "integer", "minimum": 0},
        "coverage_denominator": {"type": "integer", "minimum": 0},
        "coverage": {"$ref": "#/$defs/nullable_number"},
        "coverage_ci95_low": {"$ref": "#/$defs/nullable_number"},
        "coverage_ci95_high": {"$ref": "#/$defs/nullable_number"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "method_id", "evaluation_state", "configuration_sha256", "protocol_sha256", "bench_manifest_sha256", "run_manifest_sha256", "technical_status", "performance_qualification", "design", "primary_metrics", "results_by_age", "results_by_family_count", "profile_results", "d24_propagation_results", "leave_one_family_out", "historical_reference", "phase_error_evaluation", "criteria", "calibrated", "founder_effect_proven"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"const": "CAL-REP-14"},
    "method_id": {"const": "gamma_age_truth_bench_v1"},
    "evaluation_state": {"const": "CLOSED"},
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bench_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "technical_status": {"enum": ["PASS", "FAIL"]},
    "performance_qualification": {"const": "REVIEW_REQUIRED"},
    "design": {
      "type": "object", "additionalProperties": false,
      "required": ["ages_generations", "family_counts", "replications_per_cell", "independent_scenario_count", "primary_model", "primary_profile", "confidence_level"],
      "properties": {
        "ages_generations": {"type": "array", "items": {"type": "integer"}},
        "family_counts": {"type": "array", "items": {"type": "integer"}},
        "replications_per_cell": {"type": "integer", "minimum": 1},
        "independent_scenario_count": {"type": "integer", "minimum": 1},
        "primary_model": {"const": "CORRELATED"},
        "primary_profile": {"const": "ORACLE_EXACT"},
        "confidence_level": {"type": "number"}
      }
    },
    "primary_metrics": {"$ref": "#/$defs/metric_summary"},
    "results_by_age": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/metric_summary"}, {"type": "object", "required": ["age_generations"], "properties": {"age_generations": {"type": "integer"}}}]}},
    "results_by_family_count": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/metric_summary"}, {"type": "object", "required": ["family_count"], "properties": {"family_count": {"type": "integer"}}}]}},
    "profile_results": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/metric_summary"}, {"type": "object", "required": ["profile", "model"], "properties": {"profile": {"type": "string"}, "model": {"type": "string"}}}]}},
    "d24_propagation_results": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/metric_summary"}, {"type": "object", "required": ["profile"], "properties": {"profile": {"type": "string"}}}]}},
    "leave_one_family_out": {"type": "object", "additionalProperties": false, "required": ["evaluable_scenario_count", "mean_max_absolute_delta_generations", "p95_max_absolute_delta_generations", "three_family_status"], "properties": {"evaluable_scenario_count": {"type": "integer"}, "mean_max_absolute_delta_generations": {"type": "number"}, "p95_max_absolute_delta_generations": {"type": "number"}, "three_family_status": {"const": "NOT_EVALUABLE_AFTER_ONE_OMISSION"}}},
    "historical_reference": {"type": "object", "additionalProperties": false, "required": ["correlated_estimate_generations", "independent_estimate_generations", "maximum_absolute_reference_error_generations"], "properties": {"correlated_estimate_generations": {"type": "number"}, "independent_estimate_generations": {"type": "number"}, "maximum_absolute_reference_error_generations": {"type": "number"}}},
    "phase_error_evaluation": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NOT_EVALUABLE"}, "reason": {"type": "string"}}},
    "criteria": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "metric", "value", "threshold", "status"], "properties": {"criterion_id": {"pattern": "^CAL-AGE-00[1-6]$"}, "metric": {"type": "string"}, "value": {"type": "number"}, "threshold": {"type": ["number", "null"]}, "status": {"enum": ["PASS", "FAIL", "REVIEW_REQUIRED"]}}}},
    "calibrated": {"const": false},
    "founder_effect_proven": {"const": false}
  }
}
