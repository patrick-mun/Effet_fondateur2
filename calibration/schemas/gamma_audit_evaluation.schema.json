{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamma_audit_evaluation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "method_id", "evaluation_state", "configuration_sha256", "protocol_sha256", "bench_manifest_sha256", "run_manifest_sha256", "r_parity_sha256", "technical_status", "performance_qualification", "design", "r_parity", "contract_results", "method_results", "results_by_age", "results_by_family_count", "rho_region_counts", "criteria", "phase_error_evaluation", "calibrated", "founder_effect_proven"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"const": "CAL-REP-14A"},
    "method_id": {"const": "d25a_gamma_domain_audit_v1"},
    "evaluation_state": {"const": "CLOSED"},
    "configuration_sha256": {"$ref": "#/$defs/hash"},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "bench_manifest_sha256": {"$ref": "#/$defs/hash"},
    "run_manifest_sha256": {"$ref": "#/$defs/hash"},
    "r_parity_sha256": {"$ref": "#/$defs/hash"},
    "technical_status": {"enum": ["PASS", "FAIL"]},
    "performance_qualification": {"enum": ["FAIL", "REVIEW_REQUIRED"]},
    "design": {
      "type": "object", "additionalProperties": false,
      "required": ["ages_generations", "family_counts", "genealogy_profiles", "observation_profiles", "replications_per_cell", "independent_scenario_count", "estimate_row_count", "confidence_level"],
      "properties": {
        "ages_generations": {"type": "array", "minItems": 10, "items": {"type": "integer"}},
        "family_counts": {"type": "array", "minItems": 3, "items": {"type": "integer"}},
        "genealogy_profiles": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/genealogy"}},
        "observation_profiles": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/observation"}},
        "replications_per_cell": {"type": "integer", "minimum": 100},
        "independent_scenario_count": {"type": "integer", "minimum": 1},
        "estimate_row_count": {"type": "integer", "minimum": 1},
        "confidence_level": {"const": 0.95}
      }
    },
    "r_parity": {"$ref": "#/$defs/r_parity"},
    "contract_results": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/contract_result"}},
    "method_results": {"type": "array", "minItems": 20, "items": {"$ref": "#/$defs/method_result"}},
    "results_by_age": {"type": "array", "minItems": 60, "items": {"$ref": "#/$defs/age_result"}},
    "results_by_family_count": {"type": "array", "minItems": 18, "items": {"$ref": "#/$defs/family_result"}},
    "rho_region_counts": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/rho_counts"}},
    "criteria": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/criterion"}},
    "phase_error_evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {"status": {"const": "NOT_EVALUABLE"}, "reason": {"type": "string", "minLength": 1}}
    },
    "calibrated": {"const": false},
    "founder_effect_proven": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_number": {"type": ["number", "null"]},
    "genealogy": {"type": "string", "enum": ["INDEPENDENT", "CORRELATED_25", "CORRELATED_50"]},
    "observation": {"type": "string", "enum": ["FULL_BREAKPOINTS", "PAIRWISE_SHARED_TRUNCATED"]},
    "method": {"type": "string", "enum": ["LEGACY_INDEPENDENT_V1", "LEGACY_CORRELATED_V1", "EXACT_INDEPENDENT_ORACLE_V1", "R_FAITHFUL_INDEPENDENT_V2", "R_FAITHFUL_CORRELATED_V2"]},
    "metric_summary": {
      "type": "object",
      "required": ["total_count", "estimated_count", "not_evaluable_count", "bias", "bias_ci95_low", "bias_ci95_high", "mae", "mae_ci95_low", "mae_ci95_high", "rmse", "rmse_ci95_low", "rmse_ci95_high", "coverage_numerator", "coverage_denominator", "coverage", "coverage_ci95_low", "coverage_ci95_high", "mean_interval_length_generations"],
      "properties": {
        "total_count": {"type": "integer", "minimum": 0}, "estimated_count": {"type": "integer", "minimum": 0}, "not_evaluable_count": {"type": "integer", "minimum": 0},
        "bias": {"$ref": "#/$defs/nullable_number"}, "bias_ci95_low": {"$ref": "#/$defs/nullable_number"}, "bias_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "mae": {"$ref": "#/$defs/nullable_number"}, "mae_ci95_low": {"$ref": "#/$defs/nullable_number"}, "mae_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "rmse": {"$ref": "#/$defs/nullable_number"}, "rmse_ci95_low": {"$ref": "#/$defs/nullable_number"}, "rmse_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "coverage_numerator": {"type": "integer", "minimum": 0}, "coverage_denominator": {"type": "integer", "minimum": 0}, "coverage": {"$ref": "#/$defs/nullable_number"}, "coverage_ci95_low": {"$ref": "#/$defs/nullable_number"}, "coverage_ci95_high": {"$ref": "#/$defs/nullable_number"},
        "mean_interval_length_generations": {"$ref": "#/$defs/nullable_number"}
      }
    },
    "contract_result": {
      "allOf": [
        {"$ref": "#/$defs/metric_summary"},
        {"type": "object", "required": ["genealogy_profile", "observation_profile", "method", "lofo_evaluable_count", "lofo_mean_max_absolute_delta_generations", "lofo_p95_max_absolute_delta_generations"], "properties": {"genealogy_profile": {"$ref": "#/$defs/genealogy"}, "observation_profile": {"$ref": "#/$defs/observation"}, "method": {"$ref": "#/$defs/method"}, "lofo_evaluable_count": {"type": "integer", "minimum": 0}, "lofo_mean_max_absolute_delta_generations": {"$ref": "#/$defs/nullable_number"}, "lofo_p95_max_absolute_delta_generations": {"$ref": "#/$defs/nullable_number"}}}
      ],
      "unevaluatedProperties": false
    },
    "method_result": {
      "allOf": [
        {"$ref": "#/$defs/metric_summary"},
        {"type": "object", "required": ["genealogy_profile", "observation_profile", "method"], "properties": {"genealogy_profile": {"$ref": "#/$defs/genealogy"}, "observation_profile": {"$ref": "#/$defs/observation"}, "method": {"$ref": "#/$defs/method"}}}
      ],
      "unevaluatedProperties": false
    },
    "age_result": {
      "allOf": [
        {"$ref": "#/$defs/metric_summary"},
        {"type": "object", "required": ["genealogy_profile", "observation_profile", "method", "age_generations"], "properties": {"genealogy_profile": {"$ref": "#/$defs/genealogy"}, "observation_profile": {"$ref": "#/$defs/observation"}, "method": {"$ref": "#/$defs/method"}, "age_generations": {"type": "integer", "minimum": 1}}}
      ],
      "unevaluatedProperties": false
    },
    "family_result": {
      "allOf": [
        {"$ref": "#/$defs/metric_summary"},
        {"type": "object", "required": ["genealogy_profile", "observation_profile", "method", "family_count"], "properties": {"genealogy_profile": {"$ref": "#/$defs/genealogy"}, "observation_profile": {"$ref": "#/$defs/observation"}, "method": {"$ref": "#/$defs/method"}, "family_count": {"type": "integer", "minimum": 3}}}
      ],
      "unevaluatedProperties": false
    },
    "r_parity": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "state", "configuration_sha256", "official_r_script_sha256", "r_version", "fixture_count", "maximum_absolute_error_generations", "all_regions_match", "fixtures"],
      "properties": {
        "schema_version": {"const": "1.0.0"}, "state": {"const": "CLOSED"}, "configuration_sha256": {"$ref": "#/$defs/hash"}, "official_r_script_sha256": {"$ref": "#/$defs/hash"}, "r_version": {"type": "string", "minLength": 1}, "fixture_count": {"type": "integer", "minimum": 5}, "maximum_absolute_error_generations": {"type": "number", "minimum": 0}, "all_regions_match": {"type": "boolean"},
        "fixtures": {"type": "array", "minItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "expected_rho_region", "observed_rho_region", "rho", "maximum_absolute_error", "region_matches"], "properties": {"fixture_id": {"type": "string"}, "expected_rho_region": {"type": "string", "enum": ["I1", "I2", "I3", "NONNEGATIVE"]}, "observed_rho_region": {"type": "string", "enum": ["I1", "I2", "I3", "NONNEGATIVE"]}, "rho": {"type": "number"}, "maximum_absolute_error": {"type": "number", "minimum": 0}, "region_matches": {"type": "boolean"}}}}
      }
    },
    "rho_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["genealogy_profile", "observation_profile", "total_count", "counts"],
      "properties": {"genealogy_profile": {"$ref": "#/$defs/genealogy"}, "observation_profile": {"$ref": "#/$defs/observation"}, "total_count": {"type": "integer", "minimum": 0}, "counts": {"type": "object", "additionalProperties": false, "required": ["I1", "I2", "I3", "NONNEGATIVE"], "properties": {"I1": {"type": "integer", "minimum": 0}, "I2": {"type": "integer", "minimum": 0}, "I3": {"type": "integer", "minimum": 0}, "NONNEGATIVE": {"type": "integer", "minimum": 0}}}}
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "metric", "value", "lower_threshold", "upper_threshold", "status"],
      "properties": {"criterion_id": {"type": "string", "pattern": "^CAL-AGE-A0[1-6]$"}, "metric": {"type": "string", "minLength": 1}, "value": {"$ref": "#/$defs/nullable_number"}, "lower_threshold": {"$ref": "#/$defs/nullable_number"}, "upper_threshold": {"$ref": "#/$defs/nullable_number"}, "status": {"enum": ["PASS", "FAIL", "REVIEW_REQUIRED"]}}
    }
  }
}
