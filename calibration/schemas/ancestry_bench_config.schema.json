{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "configuration_id", "method_id", "reference_partition_role", "reference_entity_count", "requested_components", "minimum_variants", "minimum_reference_call_rate", "mixture_strata", "local_founder_stratum", "profiles", "bootstrap_replicates", "bootstrap_seed", "performance_thresholds_sealed", "production_promotion", "calibrated", "founder_effect_proven", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "configuration_id": {"const": "d27_ancestry_bench_v1"},
    "method_id": {"const": "reference_only_global_local_pca_v1"},
    "reference_partition_role": {"const": "PHASING_REFERENCE_SHARED"},
    "reference_entity_count": {"const": 1403},
    "requested_components": {"type": "integer", "minimum": 2, "maximum": 10},
    "minimum_variants": {"type": "integer", "minimum": 10},
    "minimum_reference_call_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "mixture_strata": {
      "type": "object", "additionalProperties": false,
      "required": ["REFERENCE_STRATUM_A", "REFERENCE_STRATUM_B"],
      "properties": {"REFERENCE_STRATUM_A": {"type": "string"}, "REFERENCE_STRATUM_B": {"type": "string"}}
    },
    "local_founder_stratum": {"type": "string"},
    "profiles": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "bootstrap_replicates": {"type": "integer", "minimum": 100},
    "bootstrap_seed": {"type": "integer", "minimum": 0},
    "performance_thresholds_sealed": {"const": false},
    "production_promotion": {"const": false},
    "calibrated": {"const": false},
    "founder_effect_proven": {"const": false},
    "sources": {
      "type": "object", "additionalProperties": false,
      "required": ["d12_manifest_sha256", "d14_manifest_sha256", "d17_manifest_sha256", "reference_preparation_manifest_sha256", "reference_vcf_sha256", "reference_metadata_sha256"],
      "properties": {
        "d12_manifest_sha256": {"$ref": "#/$defs/hash"},
        "d14_manifest_sha256": {"$ref": "#/$defs/hash"},
        "d17_manifest_sha256": {"$ref": "#/$defs/hash"},
        "reference_preparation_manifest_sha256": {"$ref": "#/$defs/hash"},
        "reference_vcf_sha256": {"$ref": "#/$defs/hash"},
        "reference_metadata_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
