{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/calibration/schemas/founder_haplotype_evaluation.schema.json",
  "title": "Évaluation agrégée D24 de l’étape 13",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "method_id", "report_id", "evaluation_state",
    "created_at", "configuration_sha256", "protocol_sha256",
    "source_case_sha256s", "technical_status", "performance_qualification",
    "scenario_counts", "confusion", "metrics", "criteria", "profile_results",
    "anomalies", "calibrated", "founder_effect_proven"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "method_id": {"const": "founder_haplotype_truth_bench_v1"},
    "report_id": {"const": "CAL-REP-13"},
    "evaluation_state": {"const": "CLOSED"},
    "created_at": {"type": "string", "format": "date-time"},
    "configuration_sha256": {"$ref": "#/$defs/sha"},
    "protocol_sha256": {"$ref": "#/$defs/sha"},
    "source_case_sha256s": {
      "type": "array", "minItems": 40, "maxItems": 40, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha"}
    },
    "technical_status": {"enum": ["PASS", "FAIL"]},
    "performance_qualification": {"const": "REVIEW_REQUIRED"},
    "scenario_counts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "total", "positive", "negative", "detectable_positive",
        "profiled_case_total"
      ],
      "properties": {
        "total": {"const": 10},
        "positive": {"const": 5},
        "negative": {"const": 5},
        "detectable_positive": {"type": "integer", "minimum": 0},
        "profiled_case_total": {"const": 40}
      }
    },
    "confusion": {
      "type": "object", "additionalProperties": false,
      "required": ["true_positive", "false_negative", "true_negative", "false_positive"],
      "properties": {
        "true_positive": {"type": "integer", "minimum": 0},
        "false_negative": {"type": "integer", "minimum": 0},
        "true_negative": {"type": "integer", "minimum": 0},
        "false_positive": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": [
        "founder_segment_detection_sensitivity",
        "founder_segment_detection_specificity",
        "target_containment_rate_when_detectable",
        "boundary_errors", "ibs_reclassified_as_ibd_without_explicit_ibd_count"
      ],
      "properties": {
        "founder_segment_detection_sensitivity": {"$ref": "#/$defs/rate"},
        "founder_segment_detection_specificity": {"$ref": "#/$defs/rate"},
        "target_containment_rate_when_detectable": {"$ref": "#/$defs/rate"},
        "boundary_errors": {"$ref": "#/$defs/boundaries"},
        "ibs_reclassified_as_ibd_without_explicit_ibd_count": {"type": "integer", "minimum": 0}
      }
    },
    "criteria": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {"$ref": "#/$defs/criterion"}
    },
    "profile_results": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"$ref": "#/$defs/profile"}
    },
    "anomalies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "calibrated": {"const": false},
    "founder_effect_proven": {"const": false}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableNumber": {"oneOf": [{"type": "number"}, {"type": "null"}]},
    "rate": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator", "estimate", "ci95_low", "ci95_high"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 0},
        "estimate": {"$ref": "#/$defs/nullableNumber"},
        "ci95_low": {"$ref": "#/$defs/nullableNumber"},
        "ci95_high": {"$ref": "#/$defs/nullableNumber"}
      }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": [
        "evaluated_segment_count", "evaluated_boundary_count",
        "left_mean_signed_error_bp", "right_mean_signed_error_bp",
        "left_mean_absolute_error_bp", "right_mean_absolute_error_bp",
        "left_mean_signed_error_cm", "right_mean_signed_error_cm",
        "left_mean_absolute_error_cm", "right_mean_absolute_error_cm",
        "boundary_mean_absolute_error", "family_boundary_pair_count"
      ],
      "properties": {
        "evaluated_segment_count": {"type": "integer", "minimum": 0},
        "evaluated_boundary_count": {"type": "integer", "minimum": 0},
        "left_mean_signed_error_bp": {"$ref": "#/$defs/nullableNumber"},
        "right_mean_signed_error_bp": {"$ref": "#/$defs/nullableNumber"},
        "left_mean_absolute_error_bp": {"$ref": "#/$defs/nullableNumber"},
        "right_mean_absolute_error_bp": {"$ref": "#/$defs/nullableNumber"},
        "left_mean_signed_error_cm": {"$ref": "#/$defs/nullableNumber"},
        "right_mean_signed_error_cm": {"$ref": "#/$defs/nullableNumber"},
        "left_mean_absolute_error_cm": {"$ref": "#/$defs/nullableNumber"},
        "right_mean_absolute_error_cm": {"$ref": "#/$defs/nullableNumber"},
        "boundary_mean_absolute_error": {"$ref": "#/$defs/nullableNumber"},
        "family_boundary_pair_count": {"type": "integer", "minimum": 0}
      }
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_id", "metric", "value", "denominator", "threshold", "lifecycle", "status"],
      "properties": {
        "criterion_id": {"pattern": "^CAL-FOUND-00[1-5]$"},
        "metric": {"type": "string", "minLength": 1},
        "value": {},
        "denominator": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "threshold": {},
        "lifecycle": {"enum": ["pilot_then_seal", "fixed_contract"]},
        "status": {"enum": ["PASS", "FAIL", "NOT_EVALUABLE", "REVIEW_REQUIRED"]}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "profile", "total", "positive", "negative", "detectable_positive",
        "sensitivity", "specificity", "target_containment",
        "boundary_mean_absolute_error_cm"
      ],
      "properties": {
        "profile": {"enum": ["MAXIMUM", "BASELINE", "DENSITY_50", "MISSING_1PCT"]},
        "total": {"type": "integer", "minimum": 2},
        "positive": {"type": "integer", "minimum": 0},
        "negative": {"type": "integer", "minimum": 0},
        "detectable_positive": {"type": "integer", "minimum": 0},
        "sensitivity": {"$ref": "#/$defs/nullableNumber"},
        "specificity": {"$ref": "#/$defs/nullableNumber"},
        "target_containment": {"$ref": "#/$defs/nullableNumber"},
        "boundary_mean_absolute_error_cm": {"$ref": "#/$defs/nullableNumber"}
      }
    }
  }
}
