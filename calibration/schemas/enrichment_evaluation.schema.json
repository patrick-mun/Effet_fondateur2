{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_state", "report_id", "method_id", "configuration_sha256", "protocol_sha256", "calls_manifest_sha256", "analysis_scope", "stage_execution_scope", "primary_profile", "scenario_counts", "benchmark_decision_alpha", "production_classification_threshold", "primary_metrics", "profile_results", "case_results", "non_evaluations", "criteria", "technical_status", "performance_qualification", "production_promotion", "calibrated", "founder_effect_proven", "checks", "limits"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evaluation_state": {"const": "CLOSED"},
    "report_id": {"const": "CAL-REP-16B"},
    "method_id": {"const": "d28_enrichment_evaluation_v1"},
    "configuration_sha256": {"$ref": "#/$defs/hash"},
    "protocol_sha256": {"$ref": "#/$defs/hash"},
    "calls_manifest_sha256": {"$ref": "#/$defs/hash"},
    "analysis_scope": {"type": "string"},
    "stage_execution_scope": {"type": "string"},
    "primary_profile": {"const": "MAXIMUM"},
    "scenario_counts": {"type": "object", "required": ["independent_total", "positive", "null", "profiled_case_total"]},
    "benchmark_decision_alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
    "production_classification_threshold": {"type": "null"},
    "primary_metrics": {"type": "object", "required": ["null_false_positive_rate", "positive_scenario_power", "classification_emitted_without_prespecified_threshold_count"]},
    "profile_results": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["profile", "positive_total", "null_total", "evaluable_positive", "evaluable_null", "positive_calls", "null_calls", "power", "power_ci95_low", "power_ci95_high", "null_false_positive_rate", "null_fpr_ci95_low", "null_fpr_ci95_high", "median_positive_probability", "median_null_probability", "non_evaluable_count"]}},
    "case_results": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"type": "object", "required": ["scenario_label", "truth_role", "age_generations", "profile", "evaluation_status", "non_evaluable_reason", "observed_total_shared_cm", "attempted_null_draws", "evaluable_null_draws", "non_evaluable_null_draws", "exceedance_count", "empirical_probability", "monte_carlo_interval_low", "monte_carlo_interval_high", "benchmark_positive_call", "production_status"]}},
    "non_evaluations": {"type": "array", "items": {"type": "object", "required": ["profile", "truth_role", "reason", "count"]}},
    "criteria": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["criterion_id", "metric", "value", "denominator", "threshold", "lifecycle", "status"]}},
    "technical_status": {"enum": ["PASS_CORE_EVALUATOR", "FAIL"]},
    "performance_qualification": {"const": "REVIEW_REQUIRED_UNSEALED"},
    "production_promotion": {"const": false},
    "calibrated": {"const": false},
    "founder_effect_proven": {"const": false},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limits": {"type": "array", "minItems": 5, "items": {"type": "string"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
