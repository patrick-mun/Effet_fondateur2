{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/genetic_map.schema.json",
  "title": "Carte génétique de référence V2",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": ["MAP_ID", "ASSEMBLY", "CHROMOSOME", "POSITION_BP", "POSITION_CM"],
    "null_value": "",
    "primary_key": ["MAP_ID", "CHROMOSOME", "POSITION_BP"],
    "boolean_values": {}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "decimal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["MAP_ID", "ASSEMBLY", "CHROMOSOME", "POSITION_BP", "POSITION_CM"],
      "properties": {
        "MAP_ID": {"$ref": "#/$defs/identifier"},
        "ASSEMBLY": {"type": "string", "minLength": 1},
        "CHROMOSOME": {"type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])$"},
        "POSITION_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "POSITION_CM": {"$ref": "#/$defs/decimal"}
      }
    }
  }
}
