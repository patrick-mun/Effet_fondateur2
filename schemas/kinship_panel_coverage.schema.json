{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/kinship_panel_coverage.schema.json",
  "title": "Couverture autosomique du panel d'apparentement V2",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "CHROMOSOME", "INPUT_VARIANT_COUNT", "MAF_ELIGIBLE_COUNT",
      "PRUNED_MARKER_COUNT", "MARKER_FRACTION", "SPAN_BP",
      "MEDIAN_GAP_BP", "MAX_GAP_BP", "COVERAGE_STATUS", "REASON_CODE"
    ],
    "null_value": "",
    "primary_key": ["CHROMOSOME"],
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "nonNegativeInteger": {"type": "string", "pattern": "^[0-9]+$"},
    "nullableNonNegativeInteger": {
      "oneOf": [
        {"$ref": "#/$defs/nonNegativeInteger"},
        {"type": "null"}
      ]
    },
    "nullableNonNegativeDecimal": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        {"type": "null"}
      ]
    },
    "nullableText": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CHROMOSOME", "INPUT_VARIANT_COUNT", "MAF_ELIGIBLE_COUNT",
        "PRUNED_MARKER_COUNT", "MARKER_FRACTION", "SPAN_BP",
        "MEDIAN_GAP_BP", "MAX_GAP_BP", "COVERAGE_STATUS", "REASON_CODE"
      ],
      "properties": {
        "CHROMOSOME": {"type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])$"},
        "INPUT_VARIANT_COUNT": {"$ref": "#/$defs/nonNegativeInteger"},
        "MAF_ELIGIBLE_COUNT": {"$ref": "#/$defs/nonNegativeInteger"},
        "PRUNED_MARKER_COUNT": {"$ref": "#/$defs/nonNegativeInteger"},
        "MARKER_FRACTION": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|0?\\.[0-9]+|1(\\.0+)?)$"},
        "SPAN_BP": {"$ref": "#/$defs/nullableNonNegativeInteger"},
        "MEDIAN_GAP_BP": {"$ref": "#/$defs/nullableNonNegativeDecimal"},
        "MAX_GAP_BP": {"$ref": "#/$defs/nullableNonNegativeInteger"},
        "COVERAGE_STATUS": {"enum": ["PASS", "FAIL"]},
        "REASON_CODE": {"$ref": "#/$defs/nullableText"}
      }
    }
  }
}
