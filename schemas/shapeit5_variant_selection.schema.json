{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/shapeit5_variant_selection.schema.json",
  "title": "Sélection des variants d'étude pour SHAPEIT5",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "VARIANT_ORDER", "VARIANT_ID", "CHROMOSOME", "POSITION_BP",
      "HARMONIZATION_STATUS", "SHAPEIT_ROLE", "INCLUDED", "CANONICAL_REF",
      "CANONICAL_ALT", "EXCLUSION_CODE", "IS_TARGET_VARIANT"
    ],
    "null_value": "",
    "primary_key": ["VARIANT_ID"],
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "nullableString": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "nullableAllele": {"oneOf": [{"type": "string", "pattern": "^[ACGT]+$"}, {"type": "null"}]},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "VARIANT_ORDER", "VARIANT_ID", "CHROMOSOME", "POSITION_BP",
        "HARMONIZATION_STATUS", "SHAPEIT_ROLE", "INCLUDED", "CANONICAL_REF",
        "CANONICAL_ALT", "EXCLUSION_CODE", "IS_TARGET_VARIANT"
      ],
      "properties": {
        "VARIANT_ORDER": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "VARIANT_ID": {"type": "string", "minLength": 1},
        "CHROMOSOME": {"type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])$"},
        "POSITION_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "HARMONIZATION_STATUS": {"type": "string", "minLength": 1},
        "SHAPEIT_ROLE": {"enum": ["COMMON", "COMMON_TARGET", "RARE_TARGET", "EXCLUDED"]},
        "INCLUDED": {"type": "boolean"},
        "CANONICAL_REF": {"$ref": "#/$defs/nullableAllele"},
        "CANONICAL_ALT": {"$ref": "#/$defs/nullableAllele"},
        "EXCLUSION_CODE": {"$ref": "#/$defs/nullableString"},
        "IS_TARGET_VARIANT": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"INCLUDED": {"const": true}}},
          "then": {
            "properties": {
              "SHAPEIT_ROLE": {"enum": ["COMMON", "COMMON_TARGET", "RARE_TARGET"]},
              "CANONICAL_REF": {"type": "string"},
              "CANONICAL_ALT": {"type": "string"},
              "EXCLUSION_CODE": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "SHAPEIT_ROLE": {"const": "EXCLUDED"},
              "EXCLUSION_CODE": {"type": "string"}
            }
          }
        }
      ]
    }
  }
}
