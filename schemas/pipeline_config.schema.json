{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/pipeline_config.schema.json",
  "title": "Configuration du pipeline Effet fondateur V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "target", "inputs", "tools", "policies", "stages"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "assembly"],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/stableIdentifier"
        },
        "assembly": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gene", "chromosome", "position_bp", "ref", "alt", "transcript", "project_variant_id", "rsid"],
      "properties": {
        "gene": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "chromosome": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 22},
            {"type": "null"}
          ]
        },
        "position_bp": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "ref": {
          "$ref": "#/$defs/nullableAllele"
        },
        "alt": {
          "$ref": "#/$defs/nullableAllele"
        },
        "transcript": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "project_variant_id": {
          "oneOf": [
            {"$ref": "#/$defs/stableIdentifier"},
            {"type": "null"}
          ]
        },
        "rsid": {
          "oneOf": [
            {"type": "string", "pattern": "^rs[0-9]+$"},
            {"type": "null"}
          ]
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acpa_samples_dir", "sample_metadata", "target_variant_metadata", "target_variant_genotypes", "genetic_map", "reference_panel_catalog"],
      "properties": {
        "acpa_samples_dir": {"$ref": "#/$defs/pathOrNull"},
        "sample_metadata": {"$ref": "#/$defs/pathOrNull"},
        "target_variant_metadata": {"$ref": "#/$defs/pathOrNull"},
        "target_variant_genotypes": {"$ref": "#/$defs/pathOrNull"},
        "genetic_map": {"$ref": "#/$defs/pathOrNull"},
        "genetic_map_catalog": {"$ref": "#/$defs/pathOrNull"},
        "reference_panel_catalog": {"$ref": "#/$defs/pathOrNull"},
        "ancestry_reference_catalog": {"$ref": "#/$defs/pathOrNull"},
        "sensitivity_scenarios": {"$ref": "#/$defs/pathOrNull"}
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plink", "king", "bcftools", "rscript", "phasing_adapter", "local_ibd_adapter", "explicit_ibd_adapters"],
      "properties": {
        "plink": {"$ref": "#/$defs/commandName"},
        "king": {"$ref": "#/$defs/commandName"},
        "bcftools": {"$ref": "#/$defs/commandName"},
        "rscript": {"$ref": "#/$defs/commandName"},
        "phasing_adapter": {"$ref": "#/$defs/phasingAdapter"},
        "local_ibd_adapter": {"$ref": "#/$defs/commandName"},
        "explicit_ibd_adapters": {"$ref": "#/$defs/explicitIbdAdapters"}
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overwrite_inputs", "allow_clinical_genotype_inference", "pseudonymize_figures", "stop_on_critical_warning"],
      "properties": {
        "overwrite_inputs": {"const": false},
        "allow_clinical_genotype_inference": {"const": false},
        "pseudonymize_figures": {"type": "boolean"},
        "stop_on_critical_warning": {"type": "boolean"}
      }
    },
    "stages": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "evaluate_founder_haplotype_enrichment": {"$ref": "#/$defs/founderEnrichmentStage"},
        "call_explicit_ibd": {"$ref": "#/$defs/explicitIbdStage"}
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "parameters"],
        "properties": {
          "enabled": {"type": "boolean"},
          "parameters": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "stableIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "nullableAllele": {
      "oneOf": [
        {"type": "string", "pattern": "^[ACGTN]+$"},
        {"type": "null"}
      ]
    },
    "pathOrNull": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "commandName": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "phasingAdapter": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter_id", "phase_common_command", "phase_rare_command", "expected_version"],
          "properties": {
            "adapter_id": {"const": "shapeit5_phase_common_rare_v1"},
            "phase_common_command": {"type": "string", "minLength": 1},
            "phase_rare_command": {"type": "string", "minLength": 1},
            "expected_version": {"const": "5.1.1"}
          }
        }
      ]
    },
    "explicitIbdAdapters": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["java_command", "expected_java_major", "hap_ibd_jar", "hap_ibd_version", "hap_ibd_sha256", "refined_ibd_jar", "refined_ibd_version", "refined_ibd_sha256"],
          "properties": {
            "java_command": {"type": "string", "minLength": 1},
            "expected_java_major": {"type": "integer", "minimum": 17},
            "hap_ibd_jar": {"type": "string", "minLength": 1},
            "hap_ibd_version": {"type": "string", "minLength": 1},
            "hap_ibd_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "refined_ibd_jar": {"type": "string", "minLength": 1},
            "refined_ibd_version": {"type": "string", "minLength": 1},
            "refined_ibd_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "explicitIbdStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "parameters"],
      "properties": {
        "enabled": {"type": "boolean"},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "input_scope", "primary", "sensitivities", "boundary_tolerance_bp", "maximum_control_frequency", "tool_timeout_seconds", "java_memory_mb", "threads"],
          "properties": {
            "method": {"const": "dual_target_centered_explicit_ibd_v1"},
            "input_scope": {"enum": ["TARGET_REGION", "TARGET_CHROMOSOME"]},
            "primary": {"$ref": "#/$defs/ibdScenario"},
            "sensitivities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ibdScenario"}},
            "boundary_tolerance_bp": {"type": "integer", "minimum": 0},
            "maximum_control_frequency": {"type": "number", "minimum": 0, "maximum": 1},
            "tool_timeout_seconds": {"type": "integer", "minimum": 1},
            "java_memory_mb": {"type": "integer", "minimum": 256},
            "threads": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "ibdScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "role", "minimum_cm", "minimum_markers", "calibrated", "calibration_specificity_acceptable", "control_frequency"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/stableIdentifier"},
        "role": {"enum": ["PRIMARY", "SENSITIVITY"]},
        "minimum_cm": {"type": "number", "minimum": 1},
        "minimum_markers": {"type": "integer", "minimum": 1},
        "calibrated": {"type": "boolean"},
        "calibration_specificity_acceptable": {"type": "boolean"},
        "control_frequency": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "founderEnrichmentStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "parameters"],
      "properties": {
        "enabled": {"type": "boolean"},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "primary_statistic", "minimum_independent_units", "minimum_flank_markers", "internal_null_mode", "external_null_draws", "external_null_max_attempts", "random_seed", "minimum_evaluable_null_draws", "empirical_classification_threshold", "run_superpopulation_sensitivities", "bcftools_timeout_seconds"],
          "properties": {
            "method": {"const": "target_centered_empirical_haplotype_sharing_v1"},
            "primary_statistic": {"const": "total_shared_cm"},
            "minimum_independent_units": {"type": "integer", "minimum": 3},
            "minimum_flank_markers": {"type": "integer", "minimum": 1},
            "internal_null_mode": {"const": "exhaustive"},
            "external_null_draws": {"type": "integer", "minimum": 1},
            "external_null_max_attempts": {"type": "integer", "minimum": 1},
            "random_seed": {"type": "integer", "minimum": 0},
            "minimum_evaluable_null_draws": {"type": "integer", "minimum": 1},
            "empirical_classification_threshold": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
            "run_superpopulation_sensitivities": {"type": "boolean"},
            "bcftools_timeout_seconds": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
