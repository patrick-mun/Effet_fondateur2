      "PC1": {"$ref": "#/$defs/decimal"}, "PC2": {"$ref": "#/$defs/decimal"}, "PC3": {"$ref": "#/$defs/decimal"}, "PC4": {"$ref": "#/$defs/decimal"}, "PC5": {"$ref": "#/$defs/decimal"}, "PC6": {"$ref": "#/$defs/decimal"}, "PC7": {"$ref": "#/$defs/decimal"}, "PC8": {"$ref": "#/$defs/decimal"}, "PC9": {"$ref": "#/$defs/decimal"}, "PC10": {"$ref": "#/$defs/decimal"}
    }}
