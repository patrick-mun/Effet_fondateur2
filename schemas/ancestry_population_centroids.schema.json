    "row": {"type": "object", "additionalProperties": false, "required": ["ANALYSIS_SCOPE", "GROUP_LEVEL", "GROUP_ID", "REFERENCE_ENTITY_COUNT", "PC1", "PC2", "PC3", "PC4", "PC5", "PC6", "PC7", "PC8", "PC9", "PC10"], "properties": {
