{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/ancestry_population_centroids.schema.json",
  "title": "Centroïdes descriptifs des populations 1000 Genomes",
  "x-tsv": {"schema_version": "1.0.0", "columns": ["ANALYSIS_SCOPE", "GROUP_LEVEL", "GROUP_ID", "REFERENCE_ENTITY_COUNT", "PC1", "PC2", "PC3", "PC4", "PC5", "PC6", "PC7", "PC8", "PC9", "PC10"], "null_value": "", "primary_key": ["ANALYSIS_SCOPE", "GROUP_LEVEL", "GROUP_ID"], "boolean_values": {}},
