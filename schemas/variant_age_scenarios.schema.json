{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/variant_age_scenarios.schema.json",
  "title": "Scénarios de sensibilité de datation",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": ["SCENARIO_ID", "SCENARIO_TYPE", "MODEL", "OMITTED_INDEPENDENT_UNIT_ID", "N_UNITS", "ESTIMATE_GENERATIONS", "CI_LOWER_GENERATIONS", "CI_UPPER_GENERATIONS", "GENERATION_YEARS", "ESTIMATE_YEARS", "CI_LOWER_YEARS", "CI_UPPER_YEARS", "STATUS", "EXCLUSION_CODE"],
    "null_value": "", "primary_key": ["SCENARIO_ID"],
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "count": {"type": "string", "pattern": "^[0-9]+$"},
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"},
    "nullableDecimal": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "nullableIdentifier": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["SCENARIO_ID", "SCENARIO_TYPE", "MODEL", "OMITTED_INDEPENDENT_UNIT_ID", "N_UNITS", "ESTIMATE_GENERATIONS", "CI_LOWER_GENERATIONS", "CI_UPPER_GENERATIONS", "GENERATION_YEARS", "ESTIMATE_YEARS", "CI_LOWER_YEARS", "CI_UPPER_YEARS", "STATUS", "EXCLUSION_CODE"],
      "properties": {
        "SCENARIO_ID": {"$ref": "#/$defs/identifier"}, "SCENARIO_TYPE": {"enum": ["MODEL", "LEAVE_ONE_FAMILY_OUT", "GENERATION_INTERVAL"]},
        "MODEL": {"enum": ["CORRELATED", "INDEPENDENT"]}, "OMITTED_INDEPENDENT_UNIT_ID": {"$ref": "#/$defs/nullableIdentifier"},
        "N_UNITS": {"$ref": "#/$defs/count"}, "ESTIMATE_GENERATIONS": {"$ref": "#/$defs/nullableDecimal"},
        "CI_LOWER_GENERATIONS": {"$ref": "#/$defs/nullableDecimal"}, "CI_UPPER_GENERATIONS": {"$ref": "#/$defs/nullableDecimal"},
        "GENERATION_YEARS": {"$ref": "#/$defs/nullableDecimal"}, "ESTIMATE_YEARS": {"$ref": "#/$defs/nullableDecimal"},
        "CI_LOWER_YEARS": {"$ref": "#/$defs/nullableDecimal"}, "CI_UPPER_YEARS": {"$ref": "#/$defs/nullableDecimal"},
        "STATUS": {"enum": ["ESTIMATED", "NOT_ESTIMATED"]}, "EXCLUSION_CODE": {"$ref": "#/$defs/nullableIdentifier"}
      }
    }
  }
}
