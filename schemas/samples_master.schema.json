{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/samples_master.schema.json",
  "title": "Ligne de metadata/samples.master.tsv",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "SAMPLE_ID",
      "SOURCE_FILE",
      "FID",
      "IID",
      "PID",
      "MID",
      "SEX",
      "CLINICAL_STATUS",
      "GROUP_LABEL",
      "TARGET_GENOTYPE",
      "TARGET_GENOTYPE_SOURCE",
      "ARRAY_BATCH",
      "INCLUDE_GENOMEWIDE",
      "INCLUDE_TARGET_CHROMOSOME",
      "NOTES_CODE"
    ],
    "null_value": "",
    "primary_key": ["SAMPLE_ID"],
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "stableIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "nullableStableIdentifier": {
      "oneOf": [
        {"$ref": "#/$defs/stableIdentifier"},
        {"type": "null"}
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SAMPLE_ID",
        "SOURCE_FILE",
        "FID",
        "IID",
        "PID",
        "MID",
        "SEX",
        "CLINICAL_STATUS",
        "GROUP_LABEL",
        "TARGET_GENOTYPE",
        "TARGET_GENOTYPE_SOURCE",
        "ARRAY_BATCH",
        "INCLUDE_GENOMEWIDE",
        "INCLUDE_TARGET_CHROMOSOME",
        "NOTES_CODE"
      ],
      "properties": {
        "SAMPLE_ID": {"$ref": "#/$defs/stableIdentifier"},
        "SOURCE_FILE": {"type": "string", "minLength": 1},
        "FID": {"$ref": "#/$defs/stableIdentifier"},
        "IID": {"$ref": "#/$defs/stableIdentifier"},
        "PID": {
          "anyOf": [
            {"const": "0"},
            {"$ref": "#/$defs/stableIdentifier"}
          ]
        },
        "MID": {
          "anyOf": [
            {"const": "0"},
            {"$ref": "#/$defs/stableIdentifier"}
          ]
        },
        "SEX": {"enum": ["UNKNOWN", "MALE", "FEMALE", "NOT_APPLICABLE"]},
        "CLINICAL_STATUS": {
          "enum": ["AFFECTED", "UNAFFECTED", "UNKNOWN", "NOT_REPORTED"]
        },
        "GROUP_LABEL": {"$ref": "#/$defs/stableIdentifier"},
        "TARGET_GENOTYPE": {
          "oneOf": [
            {"type": "string", "pattern": "^[ACGTN]+[/|][ACGTN]+$"},
            {"type": "null"}
          ]
        },
        "TARGET_GENOTYPE_SOURCE": {"$ref": "#/$defs/nullableStableIdentifier"},
        "ARRAY_BATCH": {"$ref": "#/$defs/nullableStableIdentifier"},
        "INCLUDE_GENOMEWIDE": {"type": "boolean"},
        "INCLUDE_TARGET_CHROMOSOME": {"type": "boolean"},
        "NOTES_CODE": {"$ref": "#/$defs/nullableStableIdentifier"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"TARGET_GENOTYPE": {"type": "string"}},
            "required": ["TARGET_GENOTYPE"]
          },
          "then": {
            "properties": {"TARGET_GENOTYPE_SOURCE": {"type": "string"}}
          },
          "else": {
            "properties": {"TARGET_GENOTYPE_SOURCE": {"type": "null"}}
          }
        }
      ]
    }
  }
}
