{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/shapeit5_sample_mapping.schema.json",
  "title": "Correspondance des échantillons PLINK vers SHAPEIT5",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "VCF_ORDER", "SAMPLE_ID", "FID", "IID", "VCF_SAMPLE_ID",
      "PEDIGREE_INCLUDED", "VCF_FATHER_ID", "VCF_MOTHER_ID"
    ],
    "null_value": "",
    "primary_key": ["SAMPLE_ID"],
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "nullableIdentifier": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "VCF_ORDER", "SAMPLE_ID", "FID", "IID", "VCF_SAMPLE_ID",
        "PEDIGREE_INCLUDED", "VCF_FATHER_ID", "VCF_MOTHER_ID"
      ],
      "properties": {
        "VCF_ORDER": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "SAMPLE_ID": {"$ref": "#/$defs/identifier"},
        "FID": {"$ref": "#/$defs/identifier"},
        "IID": {"$ref": "#/$defs/identifier"},
        "VCF_SAMPLE_ID": {"$ref": "#/$defs/identifier"},
        "PEDIGREE_INCLUDED": {"type": "boolean"},
        "VCF_FATHER_ID": {"$ref": "#/$defs/nullableIdentifier"},
        "VCF_MOTHER_ID": {"$ref": "#/$defs/nullableIdentifier"}
      }
    }
  }
}
