  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},"uint":{"type":"string","pattern":"^[0-9]+$"},"num":{"type":"string","pattern":"^-?[0-9]+(?:\\.[0-9]+)?$"},"row":{"type":"object","additionalProperties":false,"required":["TOOL","SCENARIO_ID","SAMPLE_1","HAPLOTYPE_1","FAMILY_1","SAMPLE_2","HAPLOTYPE_2","FAMILY_2","CHROMOSOME","START_BP","END_BP","START_CM","END_CM","LENGTH_CM","MARKER_COUNT","CONTAINS_TARGET"],"properties":{"TOOL":{"enum":["HAP_IBD","REFINED_IBD"]},"SCENARIO_ID":{"$ref":"#/$defs/id"},"SAMPLE_1":{"$ref":"#/$defs/id"},"HAPLOTYPE_1":{"enum":["H1","H2"]},"FAMILY_1":{"$ref":"#/$defs/id"},"SAMPLE_2":{"$ref":"#/$defs/id"},"HAPLOTYPE_2":{"enum":["H1","H2"]},"FAMILY_2":{"$ref":"#/$defs/id"},"CHROMOSOME":{"type":"string","pattern":"^(?:[1-9]|1[0-9]|2[0-2])$"},"START_BP":{"$ref":"#/$defs/uint"},"END_BP":{"$ref":"#/$defs/uint"},"START_CM":{"$ref":"#/$defs/num"},"END_CM":{"$ref":"#/$defs/num"},"LENGTH_CM":{"$ref":"#/$defs/num"},"MARKER_COUNT":{"$ref":"#/$defs/uint"},"CONTAINS_TARGET":{"type":"boolean"}}}}
