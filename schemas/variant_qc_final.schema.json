{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/variant_qc_final.schema.json",
  "title": "QC final des variants par cohorte V2",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "DATASET_ID", "COHORT_ID", "VARIANT_ID", "CHROMOSOME", "POSITION_BP",
      "A1", "A2", "N_MISS", "N_GENO", "F_MISS", "MAF", "HWE_P",
      "HWE_STATUS", "QC_STATUS", "FILTER_CODES", "IS_TARGET_VARIANT",
      "FILTER_EXCEPTION", "PRESENT_AFTER_QC"
    ],
    "null_value": "",
    "primary_key": ["DATASET_ID", "VARIANT_ID"],
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "decimal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"},
    "nullableDecimal": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "nullableCodes": {
      "oneOf": [
        {"type": "string", "pattern": "^[A-Za-z0-9._-]+(,[A-Za-z0-9._-]+)*$"},
        {"type": "null"}
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DATASET_ID", "COHORT_ID", "VARIANT_ID", "CHROMOSOME", "POSITION_BP",
        "A1", "A2", "N_MISS", "N_GENO", "F_MISS", "MAF", "HWE_P",
        "HWE_STATUS", "QC_STATUS", "FILTER_CODES", "IS_TARGET_VARIANT",
        "FILTER_EXCEPTION", "PRESENT_AFTER_QC"
      ],
      "properties": {
        "DATASET_ID": {"$ref": "#/$defs/identifier"},
        "COHORT_ID": {"$ref": "#/$defs/identifier"},
        "VARIANT_ID": {"type": "string", "minLength": 1},
        "CHROMOSOME": {"type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])$"},
        "POSITION_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "A1": {"type": "string", "pattern": "^(0|[ACGT]+)$"},
        "A2": {"type": "string", "pattern": "^(0|[ACGT]+)$"},
        "N_MISS": {"type": "string", "pattern": "^[0-9]+$"},
        "N_GENO": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "F_MISS": {"$ref": "#/$defs/decimal"},
        "MAF": {"$ref": "#/$defs/nullableDecimal"},
        "HWE_P": {"$ref": "#/$defs/nullableDecimal"},
        "HWE_STATUS": {"enum": ["EVALUATED", "NOT_EVALUATED_POLICY", "NOT_EVALUATED_DATA"]},
        "QC_STATUS": {"enum": ["PASS", "ALERT", "EXCLUDED", "RETAINED_EXCEPTION"]},
        "FILTER_CODES": {"$ref": "#/$defs/nullableCodes"},
        "IS_TARGET_VARIANT": {"type": "boolean"},
        "FILTER_EXCEPTION": {"type": "boolean"},
        "PRESENT_AFTER_QC": {"type": "boolean"}
      }
    }
  }
}
