{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/ancestry_variant_audit.schema.json",
  "title": "Audit d'harmonisation des variants d'ascendance",
  "x-tsv": {"schema_version": "1.0.0", "columns": ["ANALYSIS_SCOPE", "CHROMOSOME", "POSITION_BP", "STUDY_VARIANT_ID", "STUDY_REF", "STUDY_ALT", "REFERENCE_VARIANT_ID", "REFERENCE_REF", "REFERENCE_ALT", "STATUS", "EXCLUSION_CODE"], "null_value": "", "primary_key": ["ANALYSIS_SCOPE", "CHROMOSOME", "POSITION_BP"], "boolean_values": {}},
  "$defs": {
    "nullable": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "row": {"type": "object", "additionalProperties": false, "required": ["ANALYSIS_SCOPE", "CHROMOSOME", "POSITION_BP", "STUDY_VARIANT_ID", "STUDY_REF", "STUDY_ALT", "REFERENCE_VARIANT_ID", "REFERENCE_REF", "REFERENCE_ALT", "STATUS", "EXCLUSION_CODE"], "properties": {
      "ANALYSIS_SCOPE": {"enum": ["GLOBAL", "LOCAL"]}, "CHROMOSOME": {"type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])$"}, "POSITION_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
      "STUDY_VARIANT_ID": {"type": "string", "minLength": 1}, "STUDY_REF": {"type": "string", "pattern": "^[ACGT]+$"}, "STUDY_ALT": {"type": "string", "pattern": "^[ACGT]+$"},
      "REFERENCE_VARIANT_ID": {"$ref": "#/$defs/nullable"}, "REFERENCE_REF": {"$ref": "#/$defs/nullable"}, "REFERENCE_ALT": {"$ref": "#/$defs/nullable"},
      "STATUS": {"enum": ["INFORMATIVE", "MONOMORPHIC_REFERENCE", "LOW_REFERENCE_CALL_RATE", "ABSENT_FROM_REFERENCE", "ALLELE_MISMATCH"]},
      "EXCLUSION_CODE": {"$ref": "#/$defs/nullable"}
    }}
  }
}
