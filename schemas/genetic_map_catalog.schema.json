{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/genetic_map_catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "maps"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "maps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["map_id", "provider", "release_id", "assembly", "population_scope", "method", "archive_url", "archive_sha256", "member_template", "chromosomes"],
        "properties": {
          "map_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "provider": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "assembly": {"type": "string", "minLength": 1},
          "population_scope": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "archive_url": {"type": "string", "minLength": 1},
          "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "member_template": {"const": "chr{chromosome}.b38.gmap.gz"},
          "chromosomes": {
            "type": "array", "minItems": 22, "maxItems": 22,
            "items": {"type": "integer", "minimum": 1, "maximum": 22},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
