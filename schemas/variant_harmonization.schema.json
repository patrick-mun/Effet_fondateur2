{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/variant_harmonization.schema.json",
  "title": "Harmonisation des variants d'étude avec la référence phasée",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "STUDY_VARIANT_ORDER", "STUDY_VARIANT_ID", "ASSEMBLY", "CHROMOSOME",
      "POSITION_BP", "STUDY_A1", "STUDY_A2", "REFERENCE_ID",
      "REFERENCE_REF", "REFERENCE_ALT", "HARMONIZATION_STATUS",
      "COMMON_PHASE_ELIGIBLE", "IS_TARGET_VARIANT", "DETAIL_CODE"
    ],
    "null_value": "",
    "primary_key": ["STUDY_VARIANT_ID"],
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "nullableString": {
      "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "STUDY_VARIANT_ORDER", "STUDY_VARIANT_ID", "ASSEMBLY", "CHROMOSOME",
        "POSITION_BP", "STUDY_A1", "STUDY_A2", "REFERENCE_ID",
        "REFERENCE_REF", "REFERENCE_ALT", "HARMONIZATION_STATUS",
        "COMMON_PHASE_ELIGIBLE", "IS_TARGET_VARIANT", "DETAIL_CODE"
      ],
      "properties": {
        "STUDY_VARIANT_ORDER": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "STUDY_VARIANT_ID": {"type": "string", "minLength": 1},
        "ASSEMBLY": {"const": "GRCh38"},
        "CHROMOSOME": {"type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])$"},
        "POSITION_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "STUDY_A1": {"oneOf": [{"type": "string", "pattern": "^[ACGT]+$"}, {"type": "null"}]},
        "STUDY_A2": {"oneOf": [{"type": "string", "pattern": "^[ACGT]+$"}, {"type": "null"}]},
        "REFERENCE_ID": {"$ref": "#/$defs/nullableString"},
        "REFERENCE_REF": {"oneOf": [{"type": "string", "pattern": "^[ACGT]+$"}, {"type": "null"}]},
        "REFERENCE_ALT": {"oneOf": [{"type": "string", "pattern": "^[ACGT]+$"}, {"type": "null"}]},
        "HARMONIZATION_STATUS": {
          "enum": [
            "MATCHED_DIRECT", "MATCHED_SWAPPED", "MATCHED_REFERENCE_COMPLETED", "STUDY_ONLY",
            "ALLELE_MISMATCH", "AMBIGUOUS_REFERENCE_MATCH", "DUPLICATE_STUDY_MATCH"
          ]
        },
        "COMMON_PHASE_ELIGIBLE": {"type": "boolean"},
        "IS_TARGET_VARIANT": {"type": "boolean"},
        "DETAIL_CODE": {"$ref": "#/$defs/nullableString"}
      },
      "allOf": [
        {
          "if": {"properties": {"COMMON_PHASE_ELIGIBLE": {"const": true}}},
          "then": {
            "properties": {
              "HARMONIZATION_STATUS": {"enum": ["MATCHED_DIRECT", "MATCHED_SWAPPED", "MATCHED_REFERENCE_COMPLETED"]},
              "REFERENCE_REF": {"type": "string"},
              "REFERENCE_ALT": {"type": "string"}
            }
          }
        }
      ]
    }
  }
}
