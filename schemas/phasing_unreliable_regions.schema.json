{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/phasing_unreliable_regions.schema.json",
  "title": "Régions dont la phase cible est insuffisamment fiable",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": ["CHROMOSOME", "START_BP", "END_BP", "VARIANT_ID", "REASON", "AFFECTED_SAMPLE_COUNT"],
    "null_value": "",
    "primary_key": ["CHROMOSOME", "START_BP", "END_BP", "REASON"],
    "allow_empty": true,
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["CHROMOSOME", "START_BP", "END_BP", "VARIANT_ID", "REASON", "AFFECTED_SAMPLE_COUNT"],
      "properties": {
        "CHROMOSOME": {"type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])$"},
        "START_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "END_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "VARIANT_ID": {"type": "string", "minLength": 1},
        "REASON": {"enum": ["target_phase_confidence_below_threshold", "target_phase_confidence_not_available"]},
        "AFFECTED_SAMPLE_COUNT": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    }
  }
}
