{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/population_eigenvalues.schema.json",
  "title": "Valeurs propres de structure populationnelle V2",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "COMPONENT", "EIGENVALUE", "EXPLAINED_VARIANCE_RATIO",
      "CUMULATIVE_EXPLAINED_VARIANCE_RATIO", "SINGULAR_VALUE",
      "REFERENCE_SAMPLE_COUNT", "INFORMATIVE_VARIANT_COUNT"
    ],
    "null_value": "",
    "primary_key": ["COMPONENT"],
    "boolean_values": {}
  },
  "$defs": {
    "nonnegativeDecimal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "COMPONENT", "EIGENVALUE", "EXPLAINED_VARIANCE_RATIO",
        "CUMULATIVE_EXPLAINED_VARIANCE_RATIO", "SINGULAR_VALUE",
        "REFERENCE_SAMPLE_COUNT", "INFORMATIVE_VARIANT_COUNT"
      ],
      "properties": {
        "COMPONENT": {"type": "string", "pattern": "^PC([1-9]|10)$"},
        "EIGENVALUE": {"$ref": "#/$defs/nonnegativeDecimal"},
        "EXPLAINED_VARIANCE_RATIO": {"$ref": "#/$defs/nonnegativeDecimal"},
        "CUMULATIVE_EXPLAINED_VARIANCE_RATIO": {"$ref": "#/$defs/nonnegativeDecimal"},
        "SINGULAR_VALUE": {"$ref": "#/$defs/nonnegativeDecimal"},
        "REFERENCE_SAMPLE_COUNT": {"type": "string", "pattern": "^[2-9][0-9]*$"},
        "INFORMATIVE_VARIANT_COUNT": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    }
  }
}
