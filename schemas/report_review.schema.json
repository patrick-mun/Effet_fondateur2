{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/report_review.schema.json",
  "title": "Décision humaine sur le rapport V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "review_status", "reviewer", "reviewed_at", "facts_sha256", "draft_sha256", "sections", "checklist"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string"},
    "review_status": {"const": "APPROVED"},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "checklist": {
      "type": "object",
      "required": ["facts_checked", "limits_checked", "non_causal_language_checked", "primary_exploratory_checked"],
      "properties": {
        "facts_checked": {"const": true},
        "limits_checked": {"const": true},
        "non_causal_language_checked": {"const": true},
        "primary_exploratory_checked": {"const": true}
      }
    }
  }
}
