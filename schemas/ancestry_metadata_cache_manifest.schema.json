{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/ancestry_metadata_cache_manifest.schema.json",
  "title": "Manifeste du cache de métadonnées 1000 Genomes",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "created_at", "catalog_id", "catalog_sha256", "cache_key", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "catalog_id": {"type": "string", "minLength": 1},
    "catalog_sha256": {"$ref": "#/$defs/sha256"},
    "cache_key": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "object", "additionalProperties": false,
      "required": ["population_metadata", "unrelated_sample_index"],
      "properties": {
        "population_metadata": {"$ref": "#/$defs/file"},
        "unrelated_sample_index": {"$ref": "#/$defs/file"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["filename", "sha256"], "properties": {"filename": {"type": "string", "pattern": "^[^/\\\\]+$"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
