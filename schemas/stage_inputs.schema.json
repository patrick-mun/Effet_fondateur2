{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/stage_inputs.schema.json",
  "title": "Entrées déclarées d'une étape V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "stage_id", "stage_name", "signature", "attempt_number", "published_output_dir", "parameters", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "pattern": "^(0[0-9]|1[0-9]|T[0-9]{2})$"},
    "stage_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attempt_number": {"type": "integer", "minimum": 1},
    "published_output_dir": {"type": "string", "pattern": "^stages/[A-Za-z0-9_]+$"},
    "parameters": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "path", "media_type", "schema_name", "schema_version", "sha256", "producer_stage", "producer_signature", "assembly", "sample_set_id", "variant_set_id", "sensitivity"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "schema_name": {"type": ["string", "null"]},
        "schema_version": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "producer_stage": {"type": "string", "minLength": 1},
        "producer_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "assembly": {"type": ["string", "null"]},
        "sample_set_id": {"type": ["string", "null"]},
        "variant_set_id": {"type": ["string", "null"]},
        "sensitivity": {"enum": ["public", "internal", "sensitive_genetic"]}
      }
    }
  }
}
