{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/acpa_sample_chromosome_qc.schema.json",
  "title": "QC ACPA par échantillon et chromosome",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "SAMPLE_ID",
      "CHROMOSOME",
      "MARKER_COUNT",
      "CALLED_GENOTYPE_COUNT",
      "GENOTYPING_RATE"
    ],
    "null_value": "",
    "primary_key": ["SAMPLE_ID", "CHROMOSOME"],
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SAMPLE_ID",
        "CHROMOSOME",
        "MARKER_COUNT",
        "CALLED_GENOTYPE_COUNT",
        "GENOTYPING_RATE"
      ],
      "properties": {
        "SAMPLE_ID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "CHROMOSOME": {"type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])$"},
        "MARKER_COUNT": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "CALLED_GENOTYPE_COUNT": {"type": "string", "pattern": "^[0-9]+$"},
        "GENOTYPING_RATE": {
          "type": "string",
          "pattern": "^(0(\\.[0-9]{1,6})?|1(\\.0{1,6})?)$"
        }
      }
    }
  }
}
