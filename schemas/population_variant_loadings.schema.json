{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/population_variant_loadings.schema.json",
  "title": "Modèle de projection de structure populationnelle V2",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "VARIANT_ID", "CHROMOSOME", "POSITION_BP", "COUNTED_ALLELE",
      "REFERENCE_ALLELE_FREQUENCY", "REFERENCE_STANDARD_DEVIATION",
      "REFERENCE_CALL_RATE", "MODEL_STATUS", "EXCLUSION_CODE",
      "PC1", "PC2", "PC3", "PC4", "PC5", "PC6", "PC7", "PC8", "PC9", "PC10"
    ],
    "null_value": "",
    "primary_key": ["VARIANT_ID"],
    "boolean_values": {}
  },
  "$defs": {
    "nullableDecimal": {
      "oneOf": [
        {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"},
        {"type": "null"}
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "VARIANT_ID", "CHROMOSOME", "POSITION_BP", "COUNTED_ALLELE",
        "REFERENCE_ALLELE_FREQUENCY", "REFERENCE_STANDARD_DEVIATION",
        "REFERENCE_CALL_RATE", "MODEL_STATUS", "EXCLUSION_CODE",
        "PC1", "PC2", "PC3", "PC4", "PC5", "PC6", "PC7", "PC8", "PC9", "PC10"
      ],
      "properties": {
        "VARIANT_ID": {"type": "string", "minLength": 1},
        "CHROMOSOME": {"type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])$"},
        "POSITION_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "COUNTED_ALLELE": {"type": "string", "minLength": 1},
        "REFERENCE_ALLELE_FREQUENCY": {"$ref": "#/$defs/nullableDecimal"},
        "REFERENCE_STANDARD_DEVIATION": {"$ref": "#/$defs/nullableDecimal"},
        "REFERENCE_CALL_RATE": {"$ref": "#/$defs/nullableDecimal"},
        "MODEL_STATUS": {"enum": ["INCLUDED", "EXCLUDED"]},
        "EXCLUSION_CODE": {
          "oneOf": [
            {"enum": ["LOW_REFERENCE_CALL_RATE", "MONOMORPHIC_IN_REFERENCE"]},
            {"type": "null"}
          ]
        },
        "PC1": {"$ref": "#/$defs/nullableDecimal"},
        "PC2": {"$ref": "#/$defs/nullableDecimal"},
        "PC3": {"$ref": "#/$defs/nullableDecimal"},
        "PC4": {"$ref": "#/$defs/nullableDecimal"},
        "PC5": {"$ref": "#/$defs/nullableDecimal"},
        "PC6": {"$ref": "#/$defs/nullableDecimal"},
        "PC7": {"$ref": "#/$defs/nullableDecimal"},
        "PC8": {"$ref": "#/$defs/nullableDecimal"},
        "PC9": {"$ref": "#/$defs/nullableDecimal"},
        "PC10": {"$ref": "#/$defs/nullableDecimal"}
      }
    }
  }
}
