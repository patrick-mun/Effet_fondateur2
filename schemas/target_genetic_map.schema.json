{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/target_genetic_map.schema.json",
  "title": "Positions génétiques des variants de la région cible V2",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "DATASET_ID", "VARIANT_ORDER", "VARIANT_ID", "CHROMOSOME",
      "POSITION_BP", "POSITION_CM", "MAP_STATUS", "LEFT_MAP_BP",
      "LEFT_MAP_CM", "RIGHT_MAP_BP", "RIGHT_MAP_CM", "LOCAL_RATE_CM_PER_MB",
      "IS_TARGET_VARIANT"
    ],
    "null_value": "",
    "primary_key": ["DATASET_ID", "VARIANT_ID"],
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "decimal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"},
    "nullableDecimal": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DATASET_ID", "VARIANT_ORDER", "VARIANT_ID", "CHROMOSOME",
        "POSITION_BP", "POSITION_CM", "MAP_STATUS", "LEFT_MAP_BP",
        "LEFT_MAP_CM", "RIGHT_MAP_BP", "RIGHT_MAP_CM", "LOCAL_RATE_CM_PER_MB",
        "IS_TARGET_VARIANT"
      ],
      "properties": {
        "DATASET_ID": {"$ref": "#/$defs/identifier"},
        "VARIANT_ORDER": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "VARIANT_ID": {"type": "string", "minLength": 1},
        "CHROMOSOME": {"type": "string", "pattern": "^([1-9]|1[0-9]|2[0-2])$"},
        "POSITION_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "POSITION_CM": {"$ref": "#/$defs/decimal"},
        "MAP_STATUS": {"enum": ["EXACT", "INTERPOLATED"]},
        "LEFT_MAP_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "LEFT_MAP_CM": {"$ref": "#/$defs/decimal"},
        "RIGHT_MAP_BP": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "RIGHT_MAP_CM": {"$ref": "#/$defs/decimal"},
        "LOCAL_RATE_CM_PER_MB": {"$ref": "#/$defs/nullableDecimal"},
        "IS_TARGET_VARIANT": {"type": "boolean"}
      }
    }
  }
}
