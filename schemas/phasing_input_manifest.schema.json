{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/phasing_input_manifest.schema.json",
  "title": "Manifest d'entrée générique pour le phasage V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "format", "assembly", "chromosome", "dataset_id",
    "sample_set_id", "variant_set_id", "sample_count", "variant_count",
    "target_variant_id", "target_variant_order", "map_id", "files"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "format": {"const": "PLINK_BED_BIM_FAM_WITH_CM"},
    "assembly": {"type": "string", "minLength": 1},
    "chromosome": {"type": "integer", "minimum": 1, "maximum": 22},
    "dataset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sample_set_id": {"type": "string", "minLength": 1},
    "variant_set_id": {"type": "string", "minLength": 1},
    "sample_count": {"type": "integer", "minimum": 1},
    "variant_count": {"type": "integer", "minimum": 2},
    "target_variant_id": {"type": "string", "minLength": 1},
    "target_variant_order": {"type": "integer", "minimum": 1},
    "map_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bed", "bim", "fam", "genetic_map"],
      "properties": {
        "bed": {"type": "string", "minLength": 1},
        "bim": {"type": "string", "minLength": 1},
        "fam": {"type": "string", "minLength": 1},
        "genetic_map": {"type": "string", "minLength": 1}
      }
    }
  }
}
