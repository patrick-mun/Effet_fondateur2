{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effet-fondateur.local/schemas/sample_qc_final.schema.json",
  "title": "QC final individuel par cohorte V2",
  "x-tsv": {
    "schema_version": "1.0.0",
    "columns": [
      "DATASET_ID", "COHORT_ID", "SAMPLE_ID", "FID", "IID", "ARRAY_BATCH",
      "N_MISS", "N_GENO", "F_MISS", "QC_STATUS", "EXCLUSION_CODE",
      "PRESENT_AFTER_QC"
    ],
    "null_value": "",
    "primary_key": ["DATASET_ID", "SAMPLE_ID"],
    "boolean_values": {"true": true, "false": false}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "decimal": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DATASET_ID", "COHORT_ID", "SAMPLE_ID", "FID", "IID", "ARRAY_BATCH",
        "N_MISS", "N_GENO", "F_MISS", "QC_STATUS", "EXCLUSION_CODE",
        "PRESENT_AFTER_QC"
      ],
      "properties": {
        "DATASET_ID": {"$ref": "#/$defs/identifier"},
        "COHORT_ID": {"$ref": "#/$defs/identifier"},
        "SAMPLE_ID": {"$ref": "#/$defs/identifier"},
        "FID": {"$ref": "#/$defs/identifier"},
        "IID": {"$ref": "#/$defs/identifier"},
        "ARRAY_BATCH": {"$ref": "#/$defs/identifier"},
        "N_MISS": {"type": "string", "pattern": "^[0-9]+$"},
        "N_GENO": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "F_MISS": {"$ref": "#/$defs/decimal"},
        "QC_STATUS": {"enum": ["PASS", "EXCLUDED"]},
        "EXCLUSION_CODE": {
          "oneOf": [{"const": "sample_missingness"}, {"type": "null"}]
        },
        "PRESENT_AFTER_QC": {"type": "boolean"}
      }
    }
  }
}
